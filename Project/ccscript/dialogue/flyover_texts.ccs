import "../essential/commands.ccs"
import "../essential/stdext.ccs"

// Flyover Text Commands
command flyover_end "[00]"
command flyover_setx(n) "[01 {byte n}]"
command flyover_sety(n) "[02 {byte n}]"
command flyover_name(n) "[08 {byte n}]"
command flyover_linebreak "[09]"

// Begin Flyover texts
l_0xe10b86:
	flyover_sety(12)
	flyover_setx(50)
	"The year is 199X"
	flyover_linebreak
	flyover_end

l_0xe10b9c:
	flyover_sety(12)
	flyover_setx(12)
	"Onett, a small town in Eagleland"
	flyover_linebreak
	flyover_end

l_0xe10bc2:
	flyover_sety(12)
	flyover_setx(61)
	"{flyover_name(1)}'s house"
	flyover_linebreak
	flyover_end

l_0xe10bd2:
	flyover_sety(12)
	flyover_setx(0)
	"Winters, a small country to the north"
	flyover_linebreak
	flyover_end

l_0xe10bfd:
	flyover_sety(12)
	flyover_setx(21)
	"Snow Wood Boarding House"
	flyover_linebreak
	flyover_end

l_0xe10c1b:
	flyover_sety(12)
	flyover_setx(35)
	"Dalaam, in the Far East"
	flyover_linebreak
