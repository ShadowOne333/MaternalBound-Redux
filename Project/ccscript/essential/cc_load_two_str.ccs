//------------------------------------
// Repurposes vanilla's "19 02" (load_str) for our two-string variants
// (differentiators 3/4). str2 is referenced in place in the script and drawn
// right after each label print, so it follows its option across menu pages.
//------------------------------------
import "../essential/asm65816.ccs"
import "../essential/jsl_rts.ccs"
import "../expansion/ccexpand.ccs"
//------------------------------------
define CURRENT_FOCUS_WINDOW	= 0x7E8958
define OPEN_WINDOW_TABLE	= 0x7E88E4
define WINDOW_STATS		= 0x7E8650
define WINDOW_HEAD		= 0x7E88E0
define MULT168			= 0xC08FF7
define PRINT_LETTER		= 0xC10CB6
define PRINT_MENU_ITEMS		= 0xC1163C
define GET_STRING_RENDER_WIDTH	= 0xC43E31
define SET_TEXT_PIXEL_X		= 0xC43D75	// In: A=target pixel X (window's own
						// origin, no window_x), X=text_y (row).
						// Splits into tile+remainder internally.

define WINDOW_STATS_NEXT_OFFSET	= 0x0002
define WINDOW_STATS_ID_OFFSET	= 0x0004

define SCRATCH_BANK		= 0x007E

// Vanilla's own multi-byte-argument-gathering infrastructure, shared by
// many control codes -- NOT specific to "19 02".
define CC_ARGUMENT_GATHERING_LOOP_COUNTER	= 0x7E97CA
define TEXT_NEW_MENU_OPTION_BUFFER	= 0x7E97D7  // str1 lives here (vanilla's own buffer)

// Vanilla's own "19 02" dispatcher (UNKNOWN_C17889) and its labels,
// patched below but otherwise left completely intact.
define VANILLA_1902_DISPATCH	= 0xC17889
define VANILLA_1902_EPILOGUE	= 0xC178F5	// @UNKNOWN3: PLD; RTS (shared exit)
define VANILLA_1902_CALLONHOVER	= 0xC178A0	// @UNKNOWN0 (differentiator=1, single string)
define VANILLA_1902_NORMAL	= 0xC178B2	// @UNKNOWN1 (differentiator=2, single string)
define VANILLA_1902_APPEND	= 0xC178E5	// @UNKNOWN2 (default: append char to buffer)

// Queue of two-string options, one 7-byte entry each: +0 option address (2),
// +2 label signature (2), +4 str2 near (2), +6 str2 bank (1). str2 stays in
// the script -- only its address is stored. Three free-RAM segments.
define QUEUE_ENTRY_SIZE        = 0x0007
define QUEUE_SEG_A_ROWS        = 29
define QUEUE_SEG_B_ROWS        = 33
define MAX_QUEUE_ROWS          = 70      // vanilla's menu option pool size
define D_LoadTwoStr_QueueA     = 0x7E0732  // 29 rows, to 0x7E07FC
define D_LoadTwoStr_QueueB     = 0x7E3B2A  // 33 rows, to 0x7E3C10
define D_LoadTwoStr_QueueC     = 0x7EB43E  // 8 rows, to 0x7EB475

// menu_option / window_stats field offsets (from the disassembly).
define OPTION_PAGE             = 0x0006
define OPTION_TEXT_Y           = 0x000A
define OPTION_LABEL            = 0x0013
define WINDOW_OPTION_COUNT     = 0x002D  // byte; 0xFF = no options yet
define WINDOW_MENU_PAGE        = 0x0033

define D_LoadTwoStr_LastWindow	= 0x0122
define D_LoadTwoStr_RowCounter	= 0x0124
define D_LoadTwoStr_QueueCount	= 0x0126
// Slot index from ResolveWindowStatsAddress. Must be an absolute WRAM
// global, not a direct-page offset -- those don't survive a call
// boundary (each function gets its own D-shifted frame).
define D_LoadTwoStr_ResolvedSlot	= 0x0128

// Our dispatch has no local frame (it continues vanilla's UNKNOWN_C17889,
// whose epilogue will PLD), so all state is plain WRAM globals. At 0x7E0720
// (confirmed free); page 1 ($0000-$01FF, the stack) caused real corruption.
define D_LoadTwoStr_Phase		= 0x7E0720	// 0=str1(vanilla default),1=str2,2=callback
define D_LoadTwoStr_ExpectCallback	= 0x7E0722
define D_LoadTwoStr_CallbackByteIdx	= 0x7E0724
define D_LoadTwoStr_CallbackBuffer	= 0x7E0726	// 4 bytes, spans 0x7E0726-0x7E0729
define D_LoadTwoStr_CallbackBuffer_Hi	= 0x7E0728	// high word of the above
define D_LoadTwoStr_Str2Near   = 0x7E072A  // str2's address in the script
define D_LoadTwoStr_Str2Bank   = 0x7E072C
define D_LoadTwoStr_DrawBank   = 0x7E072E  // bank used by DrawStringViaPrintLetter
define D_LoadTwoStr_Empty      = 0x7E0730  // zero word: fallback empty string

define SIZEOF_WINDOW_STATS		= 0x0052
//------------------------------------

command load_two_str(str1, str2) "[19 02 {str1} 04 {str2} 00]"
command load_two_str_callonhover(str1, str2, target) "[19 02 {str1} 03 {str2} 00 {long target}]"

//------------------------------------
// Assembly code
//------------------------------------

// Draws a null-terminated string via PRINT_LETTER, one char at a time.
// Needs the cursor positioned (SET_TEXT_PIXEL_X) and instant printing on.
// In: A = near address; the bank is in D_LoadTwoStr_DrawBank
DrawStringViaPrintLetter: {
	M_EB_ASMFunction_Start(-0x30)

	STA_d(0x0e)
	LDA_a(D_LoadTwoStr_DrawBank)
	STA_d(0x10)

	LDY_i(0x0000)
	_loop:
		SEP(0x20)
		LDA_dly(0x0e)
		REP(0x20)
		AND_i(0x00FF)
		BEQ_a(_done)
		PHY
		JSL_RTS_C1(PRINT_LETTER)
		PLY
		INY
		BRA_a(_loop)
	_done:

	M_EB_ASMFunction_End
}

// Right edge in SET_TEXT_PIXEL_X's space. width*8 (and +1) corrupts text_x;
// width*8-1 is the safe maximum, leaving a ~2px gap.
// In: A = resolved window_stats address
GetWindowRightEdgeX: M_EB_Function_Wrapper({
	TAX

	LDA_x(0x000A)        // window_stats::width, tile units
	ASL
	ASL
	ASL                  // width * 8, in pixels
	SEC
	SBC_i(0x0001)        // back off 1px from the corruption boundary
})

// Finds window_stats for D_LoadTwoStr_LastWindow by walking the window list
// (OPEN_WINDOW_TABLE is stale for it); stores the slot in ResolvedSlot.
// Out: A = resolved window_stats address
ResolveWindowStatsAddress: M_EB_Function_Wrapper_UserStack_Clobber(-0x30, {
	LDA_a(WINDOW_HEAD)
	STA_d(0x2E)

	_findWindowLoop:
		LDA_d(0x2E)
		CMP_i(0xFFFF)
		BEQ_a(_findWindowNotFound)

		PHA                   // keep the slot index safe across MULT168/etc
		LDY_i(SIZEOF_WINDOW_STATS)
		JSL(MULT168)
		CLC
		ADC_i(WINDOW_STATS)
		STA_d(0x00)           // candidate address (temp, doesn't disturb $2E)
		TAX

		LDA_x(WINDOW_STATS_ID_OFFSET)
		CMP_a(D_LoadTwoStr_LastWindow)
		BEQ_a(_findWindowDone)

		PLA                   // discard the pushed slot index (no longer needed)
		LDA_x(WINDOW_STATS_NEXT_OFFSET)
		STA_d(0x2E)
		BRA_a(_findWindowLoop)

	_findWindowNotFound:
		LDA_i(0x0000)
		STA_a(D_LoadTwoStr_ResolvedSlot)  // safe fallback slot index
		LDA_i(WINDOW_STATS)
		BRA_a(_findWindowReturn)

	_findWindowDone:
		PLA
		STA_a(D_LoadTwoStr_ResolvedSlot)  // the matching slot index
		LDA_d(0x00)           // return value: the resolved address

	_findWindowReturn:
})

// Queue entry address for an index (index*7 = index*8 - index); the queue
// spans three RAM segments.   In: A = queue index   Out: A = entry address
GetQueueEntryAddress: M_EB_Function_Wrapper({
	CMP_i(QUEUE_SEG_A_ROWS)
	BCS_a(_queueNotA)
	PHA
	ASL
	ASL
	ASL
	SEC
	SBC_s(0x01)
	PLY
	CLC
	ADC_i(D_LoadTwoStr_QueueA)
	BRA_a(_queueEntryDone)
	_queueNotA:
	SEC
	SBC_i(QUEUE_SEG_A_ROWS)
	CMP_i(QUEUE_SEG_B_ROWS)
	BCS_a(_queueInC)
	PHA
	ASL
	ASL
	ASL
	SEC
	SBC_s(0x01)
	PLY
	CLC
	ADC_i(D_LoadTwoStr_QueueB)
	BRA_a(_queueEntryDone)
	_queueInC:
	SEC
	SBC_i(QUEUE_SEG_B_ROWS)
	PHA
	ASL
	ASL
	ASL
	SEC
	SBC_s(0x01)
	PLY
	CLC
	ADC_i(D_LoadTwoStr_QueueC)
	_queueEntryDone:
})

// Creates the option (str1 as label, null-terminated by our dispatch) and
// queues it with the address of str2 in the script. Optional callback:
// D_LoadTwoStr_CallbackBuffer.
CreateOptionAndQueueStr2: {
	M_EB_ASMFunction_Start_Clobber(-0x40)

	// New window, or first option of a fresh menu (none yet): restart queue.
	LDA_a(CURRENT_FOCUS_WINDOW)
	CMP_a(D_LoadTwoStr_LastWindow)
	BEQ_a(_sameWindow)
	STA_a(D_LoadTwoStr_LastWindow)
	LDA_i(0x0000)
	STA_a(D_LoadTwoStr_RowCounter)
	STA_a(D_LoadTwoStr_QueueCount)
	_sameWindow:

	JSL(ResolveWindowStatsAddress)
	TAX
	LDA_x(WINDOW_OPTION_COUNT)
	AND_i(0x00FF)
	CMP_i(0x00FF)
	BNE_a(_notFreshMenu)
		LDA_i(0x0000)
		STA_a(D_LoadTwoStr_RowCounter)
		STA_a(D_LoadTwoStr_QueueCount)
	_notFreshMenu:

	// ---- reserve a queue entry (stays 0 if the queue is full) ----
	LDA_i(0x0000)
	STA_d(0x20)
	LDA_a(D_LoadTwoStr_QueueCount)
	CMP_i(MAX_QUEUE_ROWS)
	BCS_a(_noEntry)
		JSL(GetQueueEntryAddress)
		STA_d(0x20)
	_noEntry:

	// ---- callback ----
	LDA_a(D_LoadTwoStr_ExpectCallback)
	BEQ_a(_noCallback)
		LDA_a(D_LoadTwoStr_CallbackBuffer)
		STA_d(0x12)
		LDA_a(D_LoadTwoStr_CallbackBuffer_Hi)
		STA_d(0x14)
		BRA_a(_gotCallback)
	_noCallback:
		LDA_i(0x0000)
		STA_d(0x12)
		STA_d(0x14)
	_gotCallback:

	// ---- create the option (str1 from vanilla's own buffer as label) ----
	LDA_i(TEXT_NEW_MENU_OPTION_BUFFER)
	STA_d(0x0e)
	LDA_i(SCRATCH_BANK)
	STA_d(0x10)
	LDX_a(D_LoadTwoStr_RowCounter)
	LDA_i(0x0000)
	JSL_RTS_C1(0xC114B1)
	STA_d(0x2A)                  // the new option's address

	LDA_d(0x20)
	BEQ_a(_skipEntry)
		LDX_d(0x20)
		LDA_d(0x2A)
		STA_x(0x0000)            // entry +0: option address
		LDX_d(0x2A)
		LDA_x(OPTION_LABEL)      // first 2 label bytes = signature
		LDX_d(0x20)
		STA_x(0x0002)            // entry +2: signature
		LDA_a(D_LoadTwoStr_Str2Near)
		STA_x(0x0004)            // entry +4: str2 near address
		SEP(0x20)
		LDA_a(D_LoadTwoStr_Str2Bank)
		STA_x(0x0006)            // entry +6: str2 bank (8-bit: last byte)
		REP(0x20)
		LDA_a(D_LoadTwoStr_QueueCount)
		INC
		STA_a(D_LoadTwoStr_QueueCount)
	_skipEntry:

	LDA_a(D_LoadTwoStr_RowCounter)
	INC
	STA_a(D_LoadTwoStr_RowCounter)

	JSL(R_Set_Working_Memory)
	LDA_i(0)

	M_EB_ASMFunction_End
}
// Draws str2 for every queued option on the CURRENT page, at the option's
// own text_y (the layout pass already assigned page/row), so str2 follows
// its label across pages. Called after each PRINT_MENU_ITEMS we hook.
DrawAllQueuedStr2: {
	M_EB_ASMFunction_Start_Clobber(-0x40)

	LDA_a(D_LoadTwoStr_QueueCount)
	BEQ_a(_nothingToDraw)
	LDA_a(CURRENT_FOCUS_WINDOW)
	CMP_a(D_LoadTwoStr_LastWindow)
	BNE_a(_nothingToDraw)

	SEI

	JSL(ResolveWindowStatsAddress)
	STA_d(0x2A)                  // window_stats address

	// Force OPEN_WINDOW_TABLE[LastWindow] to the correct slot while
	// drawing -- SET_TEXT_PIXEL_X depends on it.
	LDA_a(D_LoadTwoStr_LastWindow)
	ASL
	STA_d(0x2C)                  // table byte offset, for the restore
	TAX
	LDA_x(OPEN_WINDOW_TABLE)
	STA_d(0x32)                  // original table entry
	LDA_a(D_LoadTwoStr_ResolvedSlot)
	STA_x(OPEN_WINDOW_TABLE)

	// Save+clear VWF_INDENT_NEW_LINE, like vanilla's C4507A does.
	SEP(0x20)
	LDA_a(0x7E5E75)
	STA_d(0x36)
	STZ_a(0x7E5E75)
	REP(0x20)

	JSL(0xC3E4D4)                // SET_INSTANT_PRINTING

	LDA_i(0x0000)
	STA_d(0x00)                  // queue index

	_rowLoop:
		LDA_d(0x00)
		CMP_a(D_LoadTwoStr_QueueCount)
		BEQ_a(_allDone)

		// entry base -> $26
		LDA_d(0x00)
		JSL(GetQueueEntryAddress)
		STA_d(0x26)

		// option address -> $24
		LDX_d(0x26)
		LDA_x(0x0000)
		STA_d(0x24)

		// skip stale entries: label signature must still match
		LDX_d(0x24)
		LDA_x(OPTION_LABEL)
		LDX_d(0x26)
		CMP_x(0x0002)
		BNE_a(_nextRow)

		// skip options not on the page being shown
		LDX_d(0x24)
		LDA_x(OPTION_PAGE)
		LDX_d(0x2A)
		CMP_x(WINDOW_MENU_PAGE)
		BNE_a(_nextRow)

		// row = the option's own text_y
		LDX_d(0x24)
		LDA_x(OPTION_TEXT_Y)
		STA_d(0x38)

		// str2 far pointer from the entry (near at +4, bank at +6)
		LDX_d(0x26)
		LDA_x(0x0004)
		STA_d(0x28)
		LDA_x(0x0006)
		AND_i(0x00FF)
		STA_a(D_LoadTwoStr_DrawBank)

		// width via vanilla's getStringRenderWidth
		LDA_d(0x28)
		STA_d(0x0e)
		LDA_a(D_LoadTwoStr_DrawBank)
		STA_d(0x10)
		LDA_i(0x001E)
		JSL(GET_STRING_RENDER_WIDTH)
		STA_d(0x3A)

		// target X = right edge - width
		LDA_d(0x2A)
		JSL(GetWindowRightEdgeX)
		SEC
		SBC_d(0x3A)
		STA_d(0x34)

		LDX_d(0x38)
		LDA_d(0x34)
		JSL(SET_TEXT_PIXEL_X)

		LDA_d(0x28)
		JSL(DrawStringViaPrintLetter)

	_nextRow:
		LDA_d(0x00)
		INC
		STA_d(0x00)
		BRA_a(_rowLoop)

	_allDone:
	JSL(0xC3E4CA)                // CLEAR_INSTANT_PRINTING

	SEP(0x20)
	LDA_d(0x36)
	STA_a(0x7E5E75)
	REP(0x20)

	LDX_d(0x2C)
	LDA_d(0x32)
	STA_x(OPEN_WINDOW_TABLE)

	CLI

	_nothingToDraw:

	M_EB_ASMFunction_End
}

// Replaces UNKNOWN_C17889's entry (patched below). No local frame -- it
// continues vanilla's function, whose epilogue will PLD. X = script byte.
Our1902Dispatch: {
	LDA_a(D_LoadTwoStr_Phase)
	CMP_i(0x0001)
	BEQ_a(_str2Phase)
	CMP_i(0x0002)
	BEQ_a(_callbackPhase)

	_str1Phase:
		// Replays the overwritten TXA;CMP#1;CMP#2, adds CMP#3/CMP#4, then falls
		// to vanilla's default (append) -- 1/2/default behavior is unchanged.
		TXA
		CMP_i(0x0001)
		BEQ_a(_toVanillaCallonhover)
		CMP_i(0x0002)
		BEQ_a(_toVanillaNormal)
		CMP_i(0x0003)
		BEQ_a(_str1DoneCallback)
		CMP_i(0x0004)
		BEQ_a(_str1DoneNormal)
		JML(VANILLA_1902_APPEND)

	_toVanillaCallonhover:
		JML(VANILLA_1902_CALLONHOVER)
	_toVanillaNormal:
		JML(VANILLA_1902_NORMAL)

	_str1DoneCallback:
		LDX_a(CC_ARGUMENT_GATHERING_LOOP_COUNTER)
		SEP(0x20)
		STZ_x(TEXT_NEW_MENU_OPTION_BUFFER)
		REP(0x20)
		STZ_a(CC_ARGUMENT_GATHERING_LOOP_COUNTER)
		LDA_i(0x0001)
		STA_a(D_LoadTwoStr_ExpectCallback)
		LDA_i(0x0001)
		STA_a(D_LoadTwoStr_Phase)
		LDA_i(VANILLA_1902_DISPATCH)
		JML(VANILLA_1902_EPILOGUE)

	_str1DoneNormal:
		LDX_a(CC_ARGUMENT_GATHERING_LOOP_COUNTER)
		SEP(0x20)
		STZ_x(TEXT_NEW_MENU_OPTION_BUFFER)
		REP(0x20)
		STZ_a(CC_ARGUMENT_GATHERING_LOOP_COUNTER)
		LDA_i(0x0000)
		STA_a(D_LoadTwoStr_ExpectCallback)
		LDA_i(0x0001)
		STA_a(D_LoadTwoStr_Phase)
		LDA_i(VANILLA_1902_DISPATCH)
		JML(VANILLA_1902_EPILOGUE)

	_str2Phase:
		LDA_a(CC_ARGUMENT_GATHERING_LOOP_COUNTER)
		BNE_a(_str2Scan)

		// First byte of str2: record where it lives in the script instead of
		// copying it. The text processor already advanced its pointer, so the
		// byte is at pointer-1: WRAM[@LOCAL01] (D+0x28), else @LOCAL04 (D+0x30).
		TXA
		STA_d(0x14)              // this byte, to validate each candidate
		LDX_d(0x28)
		LDA_x(0x0000)
		DEC
		STA_d(0x0E)
		LDA_x(0x0002)
		STA_d(0x10)
		LDY_i(0x0000)
		SEP(0x20)
		LDA_dly(0x0E)
		REP(0x20)
		AND_i(0x00FF)
		CMP_d(0x14)
		BEQ_a(_str2PtrFound)

		LDA_d(0x30)
		DEC
		STA_d(0x0E)
		LDA_d(0x32)
		STA_d(0x10)
		LDY_i(0x0000)
		SEP(0x20)
		LDA_dly(0x0E)
		REP(0x20)
		AND_i(0x00FF)
		CMP_d(0x14)
		BEQ_a(_str2PtrFound)

		// Neither candidate validated: fall back to an empty string.
		STZ_a(D_LoadTwoStr_Empty)
		LDA_i(D_LoadTwoStr_Empty)
		STA_d(0x0E)
		LDA_i(0x007E)
		STA_d(0x10)
	_str2PtrFound:
		LDA_d(0x0E)
		STA_a(D_LoadTwoStr_Str2Near)
		LDA_d(0x10)
		AND_i(0x00FF)
		STA_a(D_LoadTwoStr_Str2Bank)
		LDX_d(0x14)              // restore this byte for the terminator check

	_str2Scan:
		INC_a(CC_ARGUMENT_GATHERING_LOOP_COUNTER)
		TXA
		CMP_i(0x0000)
		BEQ_a(_str2Done)
		LDA_i(VANILLA_1902_DISPATCH)
		JML(VANILLA_1902_EPILOGUE)

	_str2Done:
		STZ_a(CC_ARGUMENT_GATHERING_LOOP_COUNTER)

		LDA_a(D_LoadTwoStr_ExpectCallback)
		BEQ_a(_createOptionNow)
			LDA_i(0x0000)
			STA_a(D_LoadTwoStr_CallbackByteIdx)
			LDA_i(0x0002)
			STA_a(D_LoadTwoStr_Phase)
			LDA_i(VANILLA_1902_DISPATCH)
			JML(VANILLA_1902_EPILOGUE)

	_createOptionNow:
		JSL(CreateOptionAndQueueStr2)
		LDA_i(0x0000)
		STA_a(D_LoadTwoStr_Phase)
		LDA_i(0x0000)
		JML(VANILLA_1902_EPILOGUE)

	_callbackPhase:
		TXA
		LDX_a(D_LoadTwoStr_CallbackByteIdx)
		SEP(0x20)
		STA_x(D_LoadTwoStr_CallbackBuffer)
		REP(0x20)
		INC_a(D_LoadTwoStr_CallbackByteIdx)
		LDA_a(D_LoadTwoStr_CallbackByteIdx)
		CMP_i(0x0004)
		BEQ_a(_callbackDone)
		LDA_i(VANILLA_1902_DISPATCH)
		JML(VANILLA_1902_EPILOGUE)

	_callbackDone:
		JSL(CreateOptionAndQueueStr2)
		LDA_i(0x0000)
		STA_a(D_LoadTwoStr_Phase)
		LDA_i(0x0000)
		JML(VANILLA_1902_EPILOGUE)
}

// Replaces C1180D's tail (from "JSR C451FA"): layout, labels, then str2.
// Returns by JML to the routine's own original RTS (0xC1181A).
OurPrintStringsVerticalHook: {
	JSL(0xC451FA)
	JSL_RTS_C1(PRINT_MENU_ITEMS)
	JSL(DrawAllQueuedStr2)
	JML(0xC1181A)          // return to the routine's original ending RTS
}

//------------------------------------
// ROM patches
//------------------------------------

// UNKNOWN_C17889 ("19 02" per-byte dispatcher): its entry ("TXA; CMP #1")
// becomes a JML to our dispatch; differentiators 1/2 are unaffected.
ROM[0xC17893] = {
	JML(Our1902Dispatch)
}

// C1180D (print_strings_vertical): "JSR C451FA; JSR PRINT_MENU_ITEMS" becomes
// a JML to our hook, which redoes both, draws str2, and returns to the RTS.
ROM[0xC11813] = {
	JML(OurPrintStringsVerticalHook)
}

// Player page flips run through the cursor code, which calls
// PRINT_MENU_ITEMS itself at C11E6C. Redo it, draw str2 for the new page,
// then replay the overwritten JSL and resume at the original JMP.
OurPageFlipHook: {
	JSL_RTS_C1(PRINT_MENU_ITEMS)
	JSL(DrawAllQueuedStr2)
	JSL(0xC3E4D4)                // SET_INSTANT_PRINTING
	JML(0xC11E73)                // original "JMP @UNKNOWN5"
}

// Script-driven selection (C1181B / C11887) can also change page; redraw
// str2 after their PRINT_MENU_ITEMS call, then finish via the original RTS.
OurPageNavHook1: {
	JSL_RTS_C1(PRINT_MENU_ITEMS)
	REP(0x30)
	PHA
	JSL(DrawAllQueuedStr2)
	REP(0x30)
	PLA
	PLD
	JML(0xC11886)
}

OurPageNavHook2: {
	JSL_RTS_C1(PRINT_MENU_ITEMS)
	REP(0x30)
	PHA
	JSL(DrawAllQueuedStr2)
	REP(0x30)
	PLA
	PLD
	JML(0xC118E6)
}

// Each patch overwrites 4 bytes: "JSR PRINT_MENU_ITEMS" plus the next byte.
ROM[0xC11E6C] = {
	JML(OurPageFlipHook)
}
ROM[0xC11882] = {
	JML(OurPageNavHook1)
}
ROM[0xC118E2] = {
	JML(OurPageNavHook2)
}
