// CCS and ASM stuff below, don't edit!



































// <--------------------------------------------------------------------------------------------------------------------------------->

define Normal = "{byte 0}"
define Boss = "{byte 1}"

// Fanfare.

ROM[0xC25FC6] = JML(group_check_1)

group_check_1: {
	LDA_a(0x4A8C)
	TAX
	LDA_xl(Enemy_Groups_Boss_Flags)
	AND_i(0xFF)
	BNE(4)
	JML(0xC25FE6)
	JML(0xC25FCE)
}

// Swirl.

ROM[0xC2E94B] = JML(group_check_2)

group_check_2: {
	LDA_a(0x4A8C)
	TAX
	LDA_xl(Enemy_Groups_Boss_Flags)
	AND_i(0xFF)
	BNE(4)
	JML(0xC2E964)
	JML(0xC2E953)
}

