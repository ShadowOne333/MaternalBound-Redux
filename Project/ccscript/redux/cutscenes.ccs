//------------------------------------
//	Cutscene modifications
//------------------------------------
import "../definitions/flags.ccs"
import "../essential/cc_effects.ccs"
import "../redux/movscr_codes.ccs"
import "../redux/m_jsl_rts.ccs"
//------------------------------------
// This file does action script modifications to certain cutscenes in the original EB game
//------------------------------------
// Make the Ghost lady at the Hotel reception move quicker to avoid the player catching her while running
define Script_78	= 0xC3B86C
ROM[Script_78] = {
/* C3B86C */	m_jsr(0xC3AAB8)
/* C3B86F */	m_refresh_graphics_frame0
/* C3B873 */	m_copy_xy_to_var01
/* C3B877 */	m_set_var2(40)
/* C3B87B */	m_set_var3(40)
/* C3B87F */	m_jsr(0xC3AB8A)
/* C3B882 */	m_unset_flag(FLG_THRK_BIKINIZOMBI_F_APPEAR)	// Flag 296
/* C3B88B */	m_set_flag(FLG_THRK_BIKINIZOMBI_P_APPEAR)	// Flag 297
/* C3B894 */	m_set_speed(448)	// Walking speed of the Ghost Woman inside the Hotel's reception (256)
/* C3B89A */	m_set_result(6)
/* C3B89D */	m_jsr(0xC3AA1E)	// Set facing dest + Start walking in dir 6
/* C3B8A0 */	m_pause(32)	// 56
/* C3B8A2 */	m_jmp(Script_35)
}
//------------------------------------
//	Sky Walker scenes changes
//------------------------------------
// First Sky Walker scene (Winters)

// Script 146 modification, Make the full Sky Walker visible with the new cutscene letterboxes
ROM[0xC3C6F6] = m_set_yvel(-64)	// Make the vel axis Y so the camera moves alongside the Sky Walker
ROM[0xC3C730] = m_pause(0)	// Reduce timeout before fade out when the Sky Walker moves outside the visible map

// Script 153 modification, Make the full Sky Walker visible with the new cutscene letterboxes on Fourside
ROM[0xC3C9A0] = m_set_zpos(128)	// Make the Sky Walker appear lower so its visible with the letterbox on Fourside (192)
ROM[0xC3C9ED] = m_jml(Script_155_Hijack)
Script_155_Hijack: {
/* C3C9ED */	m_onmove(0xA00C)
		m_set_zpos(-48)
/* C3C9F0 */	m_set_anim(0)
/* C3C9F2 */	m_jml(0xC3C9F2)
}
// Script 157 modification, Make the full Sky Walker visible with the new cutscene letterboxes on Desert
ROM[0xC3CAFA] = m_set_zpos(128)	// Make the Sky Walker appear lower so its visible with the letterbox on Desert (192)
// Script 159 modification, Move the Sky Walker shadow lower on Desert
ROM[0xC3CB40] = m_set_zpos(-48)
//------------------------------------
// Second Sky Walker scene (Threek)

// Script 158 modification, Make the full Sky Walker visible with the new cutscene letterboxes on Desert
ROM[0xC3CB97] = m_set_zpos(128)	// Make the Sky Walker appear lower so its visible with the letterbox on Desert (192)
// Script 160 modification, Move the Sky Walker shadow lower on Desert
ROM[0xC3CBDD] = m_set_zpos(-48)
// Script 154 modification, Make the full Sky Walker visible with the new cutscene letterboxes on Fourside
ROM[0xC3CA4E] = m_set_zpos(128)	// Make the Sky Walker appear lower so its visible with the letterbox on Fourside (192)
ROM[0xC3CA9B] = m_jml(Script_156_Hijack)
Script_156_Hijack: {
/* C3CA9B */	m_onmove(0xA00C)
		m_set_zpos(-48)
/* C3CA9E */	m_set_anim(0)
/* C3CAA0 */	m_jml(0xC3CAA0)
}
//------------------------------------
// Third Sky Walker scene (Post-Rainy Circle)

// Script 170 modification, Make the full Sky Walker visible with the new cutscene letterboxes on Summers
// Adjusted the destination Y-pos coordinates
ROM[0xC3CF86] = /* C3CF86 */	m_set_ypos(2896)	// m_set_zpos(192) -> (128)
ROM[0xC3CFAF] = /* C3CFAF */	m_set_var7(3024)	// 3088
ROM[0xC3CFC3] = /* C3CFC3 */	m_set_var7(3024)	// 3088
ROM[0xC3CFDB] = /* C3CFDB */	m_set_var7(3152)	// 3144
// Changed zpos/zvel for ypos/yvel so the camera can now be focus on sprite 209 (Sky Walker)
ROM[0xC3CFA3] = /* C3CFA3 */	m_set_yvel(256)		// m_set_zvel(-256)
ROM[0xC3CFA8] = /* C3CFA8 */	m_set_yvel(0)		// m_set_zvel(0)
ROM[0xC3CFCE] = /* C3CFCE */	m_set_yvel(48)		// m_set_zvel(-48)
ROM[0xC3CFE3] = /* C3CFE3 */	m_set_yvel(0)		// m_set_zvel(0)

// Script 171 modification, Move the Sky Walker shadow lower on Summers
ROM[0xC3D055] = /* C3D055 */	m_set_ypos(3072)	// m_set_zpos(-48)
ROM[0xC3D078] = /* C3D078 */	m_set_var7(3072)	// 3088
ROM[0xC3D089] = /* C3D089 */	m_set_var7(3072)	// 3088
ROM[0xC3D09A] = /* C3D09A */	m_set_var7(3152)	// 3144
// The Sky walker's shadow tends to move a bit too fast with the changes above, slow it down.
ROM[0xC3D090] = /* C3D090 */	m_set_speed(244)	// Slow down the shadow when moving towards the ending point
//------------------------------------
// Script 670 modifications
ROM[0xC37CB2] = {
	m_set_var6(1256)	// Change the Teleport Monkey's X-axis standing position after his teleport (1264)
	m_set_var7(9960)	// Change the Teleport Monkey's Y-axis standing position after his teleport (9928)
}
//------------------------------------
StarmanJr_Smoke: {	// 895
	m_disable_collision()
	m_refresh_graphics_frame0()
	m_onmove(0xA37A) //84
	m_set_anim(0)
	m_task_long(MovTask_DestroyIfFar)
	m_task_long(MovTask_Anim8)

	m_priority(1)	// Put above Starman's sprite, but behind Ness
	m_set_facing_anim(0, 0)
	m_pause(8)
	m_set_facing_anim(2, 0)
	m_pause(8)
	m_set_facing_anim(4, 0)
	m_pause(8)
	m_set_facing_anim(6, 0)
	m_pause(8)
	m_destroy_self
}
//------------------------------------
define UPDATE_LETTERBOX_HDMA_TABLE	= 0xC2D0AC

PostWarp_Letterbox: {	// 896
	m_ondraw(0x9FF0)
	m_asmcall(cc_effects.instantLetterbox)
	m_asmcall(UPDATE_LETTERBOX_HDMA_TABLE)	// Build letterbox HDMA table
	m_destroy_self
	m_end
}
//------------------------------------
// Jeff decoy sprite for the Bubble monkey rope scene
Jeff_Dup: {	// 897
	m_warp_to_leader
	m_priority(0)
	m_set_facing_anim(0,0)
	m_refresh_graphics
	m_unlock_text
	m_halt
}

// Camera Pan for when Bubble Monkey lowers the rope
Rope_Camera_Pan: {	// 898
	m_warp_to_leader
	m_disable_collision
	m_priority(0)
	m_refresh_graphics_frame0
	m_onmove(0xA37A) //84
	m_set_anim(0)
	m_set_speed(100)
	m_task_long(MovTask_DestroyIfFar) // This label actually exists!
	m_task_long(MovTask_Anim8)
	m_move_until_at(5032, 320)
	m_pause(250)
	m_set_speed(100)
	m_set_dest_sprite(3)	// m_set_dest_leader, m_set_dest_pc(3)
	m_walk_to_dest	// m_walk_to_dest, m_walk_to_leader
	m_endlasttask()
	m_pause(30)
	m_unlock_text()
	m_halt
}
//------------------------------------
// Hijack the original Script 161 to remove the m_add_ypos(-128) for the Sky Walker sprite
ROM[0xC3CCBA] = { m_ontick_nop m_ontick_nop m_ontick_nop }

// Make the Sky_Walker shadow sprite appear as the offset sprite (m_add_ypos(128)) instead of the Sky Walker's sprite being the offset one
// Do this so the camera doesn't snap abruptly and the sprite appears on warp instead of a sec later
Skywalker_Camera_Fix: {	// 899 (Modification of Script 164)
	m_warp_to_pc(-1)
	m_add_ypos(128)
	m_jml(0xC3CDF5)	// Continue with the original Script 164
}
//------------------------------------
// Screen tinting codes
MOV_Make_Screen_Normal: {	// 900
	m_set_var0(0)
	m_asmcall(0xC47499)
	m_pause(1)
	m_unlock_text
	m_end
}

MOV_Tint_Screen_Black2Normal: {	// 901
	m_set_anim(0xFF)
	m_set_var0(-40)
    
	m_loop(39)
		m_add_var0(1)
		m_asmcall(0xC47499)
		m_pause(1)
	m_endloop

	m_unlock_text
	m_end
}

MOV_Tint_Screen_White2Normal: {	// 902
	m_set_anim(0xFF)
	m_set_var0(-40)
    
	m_loop(39)
		m_add_var0(1)
		m_asmcall(0xC47499)
		m_pause(1)
	m_endloop

	m_unlock_text
	m_end
}

MOV_Make_Screen_White: {	// 903
	m_set_var0(40)
	m_asmcall(0xC47499)
	m_pause(1)
	m_unlock_text
	m_end
}

MOV_Tint_Screen_White: {	// 904
	m_set_anim(0xFF)
	m_set_var0(30)
    
	m_loop(9)
		m_add_var0(1)
		m_asmcall(0xC47499)
		m_pause(12)
	m_endloop

	m_unlock_text
	m_end
}

MOV_Make_Screen_Black: {	// 905
	m_set_var0(-40)
	m_asmcall(0xC47499)
	m_pause(1)
	m_unlock_text
	m_end
}

MOV_Tint_Screen_Black: {	// 906
	m_set_anim(0xFF)
	m_set_var0(0)

	m_loop(39)
		m_add_var0(-1)
		m_asmcall(0xC47499)
		m_pause(10)
	m_endloop

	m_unlock_text
	m_end
}
//------------------------------------
