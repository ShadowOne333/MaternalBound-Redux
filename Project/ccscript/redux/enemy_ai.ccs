// CCS-based Enemy AI Scripting
// by JTolmar and The_Kirby
// (Mostly JTolmar but I reused The_Kirby's hijack. Also shoutouts to Coop for making ccexpand)
//------------------------------------

import "../essential/asm65816.ccs"
import "../expansion/ccexpand.ccs"
import "../redux/enemy_ai_actions.ccs"

//------------------------------------
// Instructions (once installed):
// - write the enemy's logic in ccscript (anywhere, doesn't need to be this file)
// - put that CCScript label in that enemy's slot in EnemyAiTable below
//   (e.g. if your new code is at the label MyNewScript in enemy_stuff.ccs,
//     replace NoAi with enemy_stuff.MyNewScript for that enemy ID)
// - set the enemy's action order to something higher than 4

// CCScript enemy logic:
// - It works like normal CCscript, you can use call(), goto(), flags, all the normal stuff
// - The script runs until it hits an eob, like normal, but...
//   on the next turn, the script will resume from the next command after the eob
// - This means the script can't end! Make sure to make an infinite loop with a goto().
// - The ccscript registers (arg, result, counter) are not saved past an eob.
// Example script:
//    ExampleAi:
//      window_open(1)
//      "@Welcome to the AI test buddy." next
//      window_closetop
//      setAction(132, 0) eob
//    ExampleAi_Loop:
//      if checkPpThreshold(4) {
//        setAction(54, 45) eob	// Magnet A
//        goto(ExampleAi_Loop)
//      }
//      if checkHpThreshold(17) {
//        window_open(1)
//        "@Ow my scales." next
//        window_closetop
//        setAction(32, 23) eob	// Lifeup A
//        goto(ExampleAi_Loop)
//      }
//      setAction(4, 0) eob	// Bash
//      goto(ExampleAi_Loop)
// Another example, controlling King's AI with a menu:
//    ExampleKing:
//      window_open(15)
//      menu 2 {
//        "Bite": { setAction(238, 0) goto(ExampleKing_postMenu) }
//        "Lunge": { setAction(114, 0) goto(ExampleKing_postMenu) }
//        "Charge": { setAction(226, 0) goto(ExampleKing_postMenu) }
//        "Bark": { setAction(264, 0) goto(ExampleKing_postMenu) }
//      }
//      goto(ExampleKing)
//      ExampleKing_postMenu:
//        window_closetop
//        eob	// do the attack
//        goto(ExampleKing)
// - Enemy scripts run at the start of the turn, before anyone acts. If you want to open a window
//   and start chatting or something, it will happen there, not when the enemy acts.

// Installation
// - This requires ccexpand
// - Add ControlCodesetAction to ccexpand, and set CC_SET_ACTION to match the slot you used
define CC_SET_ACTION = "[1A 1B]"	// ControlCodeSetAction - used by setAction()
// - Repeat this for any of the below commands that you want to be able to use
define CC_HP_THRESHOLD = "[1A 1C]"	// ControlCodeHpThreshold - used by checkHpThreshold()
define CC_PP_THRESHOLD = "[1A 1D]"	// ControlCodePpThreshold - used by checkPpThreshold()
define CC_CHECK_STATUS = "[1A 1E]"	// ControlCodeCheckStatus - used by checkStatus()
// (You don't actually have to do any of these, even setAction, but this script sure isn't very
//  useful if you don't lol)

