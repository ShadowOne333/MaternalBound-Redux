// If you expanded the enemy table somehow, this table will keep going. It only relies on the enemy
// ID field still being there in the first two bytes of the battler struct.

//------------------------------------
// ---- Commands and their documentation ----
// Sets the action and argument that the enemy will use this turn.
// If you call it more than once in a turn, the last call will win.
command setAction(action, argument) { CC_SET_ACTION short action byte argument }

// Checks the enemy's HP. Returns true if current HP is this number or lower (in the result reg)
command checkHpThreshold(hp) { CC_HP_THRESHOLD short hp }

// Checks the enemy's HP. Returns true if current PP is this number or lower (in the result reg)
command checkPpThreshold(pp) { CC_PP_THRESHOLD short pp }

// Checks for a specific status. Returns true if present, in result register
command checkStatus(group, status) { CC_CHECK_STATUS byte group byte status }

//------------------------------------
// Advanced - making new control codes
// - It's just normal CCExpand control codes
// - The enemy who's AI we're running is in CURRENT_ATTACKER (0x7EA970)

// Advanced - compatibility
// - Repurposes the money field from the battler struct to be more AI state
// - touches battleInitEnemyStats (where it loads money)
// - touches the enemy AI selector in the main battle routine
// - touches koTarget where it tracks money (because it's not in the battler struct anymore)

// Empty AI
DoNothing:
	eob
	goto(DoNothing)

// ---- Implementation stuff now ----
define CURRENT_ATTACKER = 0x7EA970
define CCE_arg_byte = 0x06 // Used by CCExpand

// Implementation -- main hijack (borrowed from The_Kirby)
ROM[0xC25363] = JML(BattleScripts_Hijack)
BattleScripts_Hijack:
	BNE(4)
	JML(0xC25377)//Random
	CMP_i(1)
	BNE(4)
	JML(0xC25385)//Random, Action #1 = 1/2, Action #2 = 1/4, Actions #3 and #4 = 1/8
	CMP_i(2)
	BNE(4)
	JML(0xC253C3)//In order
	CMP_i(3)
	BNE(4)
	JML(0xC253E6)//Two sets of random actions cycled each round.
	CMP_i(4)
	BCC(4)
	JML(BattleScripts_Main)
	JML(0xC25419)
BattleScripts_Main:
	LDX_d(0x02)
	STA_d(0x04)
	LDA_x(0x000F)//Load NPC value.
	AND_i(0x00FF)
	BNE_a(BattleScripts_Main2)
	LDA_x(0x000E)//Load party value.
	AND_i(0x00FF)
	BNE_a(BattleScripts_Main2)
	LDA_d(0x04)
	SEC
	SBC_i(4)
	JML(BattleScripts_Hijack)
// This is where the AI script starts and the difference from The_Kirby's version
BattleScripts_Main2:
	STX_a(CURRENT_ATTACKER) // Save the enemy to CURRENT_ATTACKER so script can use it
	// Call text using saved pointer
	LDA_x(6)    // AI state
	AND_i(0xFF)
	STA_d(0x10)
	LDA_x(61) // Money (repurposed as the rest of the AI state)
	STA_d(0x0E)
	JSL(0xC186B1) // Call text
	LDX_d(0x02) // enemy pointer
	LDA_d(0x06) // Return val
	STA_x(61) // Money
	LDA_d(0x08) // More return val
	STA_x8(6) // AI state
	// Jump back into normal flow
	JML(0xC25466)

// Implementation -- patch battleInitEnemyStats to store the initial script
//  C2B88F: A6 02           LDX @VIRTUAL02
//  C2B891: 9D 3D 00        STA a:battler::money,X
ROM[0xC2B88F] = { JSL(BattleInitPatch) NOP }
BattleInitPatch:
	// Load the AI state instead of money
	LDY_d(0x02) // battler pointer in Y
	LDA_y(0) // enemy ID
	ASL ASL // mul 4
	TAX // offset into enemy AI table in X
	LDA_xl(EnemyAiTable) // loading low two bytes, store into extended AI state (formerly money)
	STA_y(61) // Was money, now more state
	INX INX
	LDA_xl(EnemyAiTable) // loading high two bytes, store the good one into AI state
	STA_y8(6) // AI state
	RTL

// Implementation -- patch koTarget to not need money in battler
// this is the only place where battler money is actually used, and it can be found in the enemy
// table instead, so by changing it here, I get the extra two bytes needed to store the AI state
//  C278AD: BD 3D 00        LDA a:battler::money,X
//  C278B0: 18              CLC
ROM[0xC278AD] = JSL(KoBattlerPatch)
KoBattlerPatch:
	// Get pointer to enemy config table
	LDA_x(0) // get enemy ID
	LDY_i(0x5E) // size of enemy data struct
	JSL(0xC08FF7) // mult
	TAX
	LDA_x(0x29) // enemy data money
	CLC // missing CLC we clobbered
	RTL

// Implementation -- ccexpand codes
ControlCodeSetAction: M_EB_Function_Wrapper({
	M_Read_Bytes_or_Arg(2) // action
	LDA_d(CCE_arg_byte)
	LDX_a(CURRENT_ATTACKER)
	STA_x(4) // current action
	M_Read_Bytes_or_Arg(1) // arg
	LDA_d(CCE_arg_byte)
	LDX_a(CURRENT_ATTACKER)
	STA_x8(8) // action arg
})

ControlCodeHpThreshold: M_EB_Function_Wrapper({
	STZ_d(0x0E) // Default return value (false)
	STZ_d(0x10) // Unused high bytes of return value
	// Read the HP argument
	M_Read_Bytes_or_Arg(2)
	LDA_d(CCE_arg_byte)
	// Compare with attacker
	LDX_a(CURRENT_ATTACKER)
	CMP_x(17) // HP 
	BMI_a(_end)
	LDA_i(1)
	STA_d(0x0E) // return 1
_end:
	JSL(R_Set_Working_Memory)
})

ControlCodePpThreshold: M_EB_Function_Wrapper({
	STZ_d(0x0E) // Default return value (false)
	STZ_d(0x10) // Unused high bytes of return value
	// Read the PP argument
	M_Read_Bytes_or_Arg(2)
	LDA_d(CCE_arg_byte)
	// Compare with attacker
	LDX_a(CURRENT_ATTACKER)
	CMP_x(23) // PP
	BMI_a(_end)
	LDA_i(1)
	STA_d(0x0E) // return 1
_end:
	JSL(R_Set_Working_Memory)
})

ControlCodeCheckStatus: M_EB_Function_Wrapper({
	STZ_d(0x0E) // Default return value (false)
	STZ_d(0x10) // Unused high bytes of return value
	// Read the group argument
	M_Read_Bytes_or_Arg(1)
	LDA_d(CCE_arg_byte)
	STA_d(0) // Stash in 0
	// Read the status argument
	M_Read_Bytes_or_Arg(1)
	LDA_d(CCE_arg_byte)
	// Check for match
	CMP_d(0)
	BNE_a(_end)
	STA_d(0x0E) // return 1
_end:
	JSL(R_Set_Working_Memory)
})


// Helper function - 8 bit STA foo,x
command STA_x8(offset) {
	SEP(0x20)
	STA_x(offset)
	REP(0x20)
}

// Helper function - 8 bit STA foo,y
command STA_y8(offset) {
	SEP(0x20)
	STA_y(offset)
	REP(0x20)
}

