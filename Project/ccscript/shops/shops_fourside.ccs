//------------------------------------------------------------------
// Fourside Junk shop
//------------------------------------------------------------------
FoursideJunk_Greeting:		//l_0xc5c1e5
	"@C'mon in!" linebreak
	"  We've got the goods, G!" next
	eob

FoursideJunk_Exit_Store_Buy:		//l_0xc5c203
	"@Thanks a lot, bro!" end

FoursideJunk_Exit_Store_Dont_Buy:	//l_0xc5c210
	"@God damn!" linebreak
	"  You can't do me like that!" end

FoursideJunk_Open_Shop_Window:	//l_0xc5c22e
	"@What are you looking for?!" next
	eob

FoursideJunk_Selected_Item: {		//l_0xc5c23b
	"@Okay, {call(_gender_check)}.  You want" linebreak
	"  the {itemname(0)}?" next
	eob

_gender_check:
	get_char_at_pos(1)
	result_is(2)
	goto_if_true(_paula_leader)
	"man"
	eob

_paula_leader:
	"woman"
	eob
}

FoursideJunk_Who_Will_Take_Item:	//l_0xc5c252
	"@Hey guys, who's going to carry this?" next
	eob

FoursideJunk_Equip_Now:			// This shop doesn't sell equippables
	eob

FoursideJunk_Buy_Previous_Equipment:	// This shop doesn't sell equippables
 // arg: item name, res: item price
	eob

FoursideJunk_Cant_Equip_Item:		// This shop doesn't sell equippables
// arg: player name
	eob

FoursideJunk_Cancel_Cant_Equip:		//l_0xc5c268
// despite the name, it's often used as a generic change of mind
	"@I'm with you." linebreak
	"  Lookin' for anything else?" next
	eob

FoursideJunk_Not_Enough_Cash:		//l_0xc5c27f
	sound(SND_ERRORBEEP)
	"@Hey homiee!" linebreak
	"  You ain't got the dough for this purchase!" promptw
	eob

FoursideJunk_Whole_Party_Full_Inventory:	//l_0xc5c2a5
	sound(SND_ERRORBEEP)
	"@Most unfortunately for you," linebreak
	"  you're carrying too much stuff." end

FoursideJunk_What_To_Sell:	// This shop doesn't purchase items
	eob

FoursideJunk_Confirm_Selling:	// This shop doesn't purchase items
// arg: item ID, res: item sell price
	eob

FoursideJunk_Cancel_Selling:	// This shop doesn't purchase items
	eob

FoursideJunk_Nothing_To_Sell:	// This shop doesn't purchase items
	eob

FoursideJunk_Unsellable_Item:	// This shop doesn't purchase items
	eob

FoursideJunk_Transaction_Thanks:	//l_0xc5c2c6
	"@Thank you, thank you." next
	eob

FoursideJunk_Transaction_Thanks_2:	//l_0xc5c2d2
// when is this used?
	"@Thank you, thank you." next
	eob

FoursideJunk_Request_Another_Transaction:	//l_0xc5c2de
	"@Do you need anything else?" linebreak
	eob

FoursideJunk_Do_Another_Transaction:		// This shop doesn't run this line
	eob

FoursideJunk_Chosen_Character_Inventory_Full:	//l_0xc5c2e7
	"@Sorry, buddy!" linebreak
	"  {name(0)} has got too much stuff already." next
	"@One of you other guys want to haul it for " swap call(data_37.l_0xc7e6a4) "?" linebreak
	eob

FoursideJunk_Bulk_Buy_Lots:
	"@All these?" next
	eob

FoursideJunk_Bulk_Buy_Not_Enough_Cash:
	sound(SND_ERRORBEEP)
	"@Hey homiee!" linebreak
	"  You ain't got the dough for these purchases!" promptw
	eob

FoursideJunk_Bulk_Buy_Full_Inventory:
	sound(SND_ERRORBEEP)
	"@Most unfortunately for you," linebreak
	"  you're carrying too much stuff." end

FoursideJunk_Bulk_Buy_Change_Of_Mind:
	"@I'm with you." linebreak
	"  Lookin' for anything else?" next
	eob

