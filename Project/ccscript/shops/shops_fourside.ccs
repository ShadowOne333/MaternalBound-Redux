//------------------------------------------------------------------
FoursideCondiment_Greeting:		//l_0xc5ce22
	"@Hello there!" next
	"@How would you like to buy some seasonings" next
	"@that go great on your food at meal time?" next
	"@These are not just your average seasonings!" next
	"@Whenever you try to eat something, the seasoning will automatically sprinkle" next
	"@on your food.  It's really almost magical!" next
	eob

FoursideCondiment_Exit_Store_Buy:	//l_0xc5cec0
	"@Please come again." end

FoursideCondiment_Exit_Store_Dont_Buy:	//l_0xc5cec8
	"@Please come again." end

FoursideCondiment_Open_Shop_Window:	//l_0xc5ced0
	"@What would you like?" next
	eob

FoursideCondiment_Selected_Item:	//l_0xc5cedc
	"@{itemname(0)}?" next
	eob

FoursideCondiment_Who_Will_Take_Item:	//l_0xc5cee4
	"@Who is going to carry it?" promptw
	eob

FoursideCondiment_Equip_Now:			// This shop doesn't sell equippables
	eob

FoursideCondiment_Buy_Previous_Equipment:	// This shop doesn't sell equippables
 // arg: item name, res: item price
	eob

FoursideCondiment_Cant_Equip_Item:		// This shop doesn't sell equippables
// arg: player name
	eob

FoursideCondiment_Cancel_Cant_Equip:	//l_0xc5cef0
// despite the name, it's often used as a generic change of mind
	"@Please come again." next
	eob

FoursideCondiment_Not_Enough_Cash:	//l_0xc5cef9
	sound(SND_ERRORBEEP)
	"@Oh, it looks like you don't have enough money." next
	eob

FoursideCondiment_Whole_Party_Full_Inventory:	//l_0xc5cf0a
	sound(SND_ERRORBEEP)
	"@Oh, I don't think you can carry any more." end

FoursideCondiment_What_To_Sell:		// This shop doesn't purchase items
	eob

FoursideCondiment_Confirm_Selling:	// This shop doesn't purchase items
// arg: item ID, res: item sell price
	eob

FoursideCondiment_Cancel_Selling:	// This shop doesn't purchase items
	eob

FoursideCondiment_Nothing_To_Sell:	// This shop doesn't purchase items
	eob

FoursideCondiment_Unsellable_Item:	// This shop doesn't purchase items
	eob

FoursideCondiment_Transaction_Thanks:	//l_0xc5cf1c
	"@Thank you very much." next
	eob

FoursideCondiment_Transaction_Thanks_2:	//l_0xc5cf26
// when is this used?
	"@Thank you very much." next
	eob

FoursideCondiment_Request_Another_Transaction:	//l_0xc5cf30
	"@Would you like to buy anything else?" linebreak
	eob

FoursideCondiment_Do_Another_Transaction:		// This shop doesn't run this line
	eob

FoursideCondiment_Chosen_Character_Inventory_Full:	//l_0xc5cf3d
	"@{name(0)} is already carrying too many things." next
	"@Can someone else carry it?" linebreak
	eob

FoursideCondiment_Bulk_Buy_Lots:
	"@All of these?" next
	eob

FoursideCondiment_Bulk_Buy_Not_Enough_Cash:
	sound(SND_ERRORBEEP)
	"@Oh, it looks like you don't have enough money." next
	eob

FoursideCondiment_Bulk_Buy_Full_Inventory:
	sound(SND_ERRORBEEP)
	"@Oh, I don't think you can carry all of these." end

FoursideCondiment_Bulk_Buy_Change_Of_Mind:
	"@Please come again." next
	eob

//------------------------------------------------------------------
// Fourside Dept. Store Sports Shop
//------------------------------------------------------------------
FoursideSports_Greeting:		//l_0xc51eea
	"@Hey dudes!  It's summer!" linebreak
	"  It's the manly time of year!" linebreak
	"  Time for sports, guys!" next
	"@What can I do you for?" linebreak
	eob

FoursideSports_Exit_Store_Buy:	//l_0xc51f2c
	"@Hey buddy, thanks!" linebreak
	"  See you around!" end

FoursideSports_Exit_Store_Dont_Buy:	//l_0xc51f45
	"@If you ever need anything, come back here, and I'll set you up!" end

FoursideSports_Open_Shop_Window:	//l_0xc51f62
	"@So what'll it be today?" promptw
	eob

FoursideSports_Selected_Item:	//l_0xc51f74
	"@{itemname(0)}?" next
	eob

FoursideSports_Who_Will_Take_Item:	//l_0xc51f7c
	"@Which of you is going to carry this?" promptw
	eob

FoursideSports_Equip_Now:			//l_0xc51f91
	"@So, man, are you gonna equip it here?" linebreak
	eob

FoursideSports_Buy_Previous_Equipment:	//l_0xc51fa7
 // arg: item name, res: item price
	"@Can I buy your" linebreak
	"  {itemname(0)}" linebreak
	"  for {swap}$" number(0) "?" linebreak
	eob

FoursideSports_Cant_Equip_Item:	//l_0xc51fc8
// arg: player name
	"@{name(0)} can't equip this." next
	"  Do ya still want to buy it?" linebreak
	eob

FoursideSports_Cancel_Cant_Equip:	//l_0xc51fe7
// despite the name, it's often used as a generic change of mind
	"@Catch ya later!" next
	eob

FoursideSports_Not_Enough_Cash:	//l_0xc51ff8
	sound(SND_ERRORBEEP)
	"@Oh, most heinous!" linebreak
	"  You dudes don't have enough money for this." next
	eob

FoursideSports_Whole_Party_Full_Inventory:	//l_0xc5201d
	sound(SND_ERRORBEEP)
	"@Dudes!" linebreak
	"  You simply have too much stuff in your kit!" next
	"@But don't sweat it, I can buy some stuff you don't need." linebreak
	eob

FoursideSports_What_To_Sell:		//l_0xc52059
	"@Now, you're sure you want to sell this to me..." promptw
	eob

FoursideSports_Confirm_Selling:	//l_0xc5206d
	"@The {itemname(0)}?" linebreak
	"  I'll buy it for {swap}$" number(0) "." next
	"@You positive you want to sell it?" linebreak
	eob

FoursideSports_Cancel_Selling:	//l_0xc5209b
	"@OK." next
	eob

FoursideSports_Nothing_To_Sell:	//l_0xc520a2
	"@Man, you don't have anything to sell me!" next
	eob

FoursideSports_Unsellable_Item:	//l_0xc520b9
	"@Sorry dude, but I can't buy that." next
	eob

FoursideSports_Transaction_Thanks:	//l_0xc520cf
	"@Thanks!" next
	eob

FoursideSports_Transaction_Thanks_2:	//l_0xc520d5
// when is this used?
	"@Thanks, buddy!" next
	eob

FoursideSports_Request_Another_Transaction:	//l_0xc520e1
	"@Is there anything else I can do for you?" linebreak
	eob

FoursideSports_Do_Another_Transaction:	//l_0xc520f1
	"@What is it?" linebreak
	eob

FoursideSports_Chosen_Character_Inventory_Full:	//l_0xc520fa
	"@{name(0)} has too many things." next
	"@Does somebody else want to carry it?" linebreak
	eob

FoursideSports_Bulk_Buy_Lots:
	"@All these?" next
	eob

FoursideSports_Bulk_Buy_Not_Enough_Cash:
	sound(SND_ERRORBEEP)
	"@Oh, most heinous!" linebreak
	"  You dudes don't have enough money for these." next
	eob

FoursideSports_Bulk_Buy_Full_Inventory:
	sound(SND_ERRORBEEP)
	"@Dudes!" next
	"@You simply have too much stuff in your kit for these!" next
	"@But don't sweat it, I can buy some stuff you don't need." linebreak
	eob

FoursideSports_Bulk_Buy_Change_Of_Mind:
	"@Catch ya later!" next
	eob

