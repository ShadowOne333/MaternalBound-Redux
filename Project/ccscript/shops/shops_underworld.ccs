//------------------------------------------------------------------
import "../definitions/flags.ccs"
import "../essential/asm65816.ccs"
import "../expansion/ccexpand.ccs"
import "../essential/commands.ccs"
import "../essential/stdext.ccs"
//------------------------------------------------------------------
// Lost Underworld shop
//------------------------------------------------------------------
LostUnderworld_Greeting:		//l_0xc5341d
	"@Let's play store.  My friend Angrez loves this game.  So..." next
	"@Hi!  May I help you?" linebreak
	eob

LostUnderworld_Exit_Store_Buy:		//l_0xc53454
	"@Bye bye!" linebreak
	"  Let's play again some time!" end

LostUnderworld_Exit_Store_Dont_Buy:	//l_0xc5346f
	"@Bye bye!" linebreak
	"  Let's play again some time!" end

LostUnderworld_Open_Shop_Window:	//l_0xc5348a
	"@Are you looking for anything in particular?" promptw
	eob

LostUnderworld_Selected_Item:		//l_0xc5349f
	"@{itemname(0)}?" next
	eob

LostUnderworld_Who_Will_Take_Item:	//l_0xc534a7
	"@Who is going to carry this?" promptw
	eob

LostUnderworld_Equip_Now:		//l_0xc534b6
	"@Do you want to try equipping it here?" linebreak
	eob

LostUnderworld_Buy_Previous_Equipment:	//l_0xc534c8
 // arg: item name, res: item price
	"@Do you want me to buy  your {itemname(0)}" next
	"@for {swap}$" number(0) "?" linebreak
	eob

LostUnderworld_Cant_Equip_Item:		//l_0xc534e9
// arg: player name
	"@Did you realize that {name(0)} can't equip this?" next
	"@Do you still want to purchase it?" linebreak
	eob

LostUnderworld_Cancel_Cant_Equip:	//l_0xc53515
// despite the name, it's often used as a generic change of mind
	"@Well, the customer is always right." next
	eob

LostUnderworld_Not_Enough_Cash:		//l_0xc5352c
	sound(SND_ERRORBEEP)
	get_char_at_pos(1)
	"@" call(data_37.l_0xc7e6c5) ", it appears you do not have the money necessary for this transaction." next
	eob

LostUnderworld_Whole_Party_Full_Inventory:	//l_0xc53562
	sound(SND_ERRORBEEP)
	"@I really don't think you can carry any more purchases." next
	"@You can come again after you sell something," next
	"@or you can simply discard an item to lighten your load." next
	"@Or, you might want to sell the things you don't need here!" next
	eob

LostUnderworld_What_To_Sell:	//l_0xc535d3
	"@What would you like to sell?" promptw
	eob

LostUnderworld_Confirm_Selling:	//l_0xc535df
// arg: item ID, res: item sell price
	"@{itemname(0)}?" linebreak
	"  I'm authorized to pay up to" linebreak
	"  {swap}$" number(0) " for that." next
	"@How about it?" linebreak
	eob

LostUnderworld_Cancel_Selling:	//l_0xc53615
	"@That's fine.  It's the customer's prerogative to change his or her mind." next
	eob

LostUnderworld_Nothing_To_Sell:	//l_0xc53645
	"@Though I really would like to buy something from you, you have nothing to offer." next
	eob

LostUnderworld_Unsellable_Item:	//l_0xc5366d
	"@Sorry, I'm not authorized to buy that." next
	eob

LostUnderworld_Transaction_Thanks:	//l_0xc53687
	get_char_at_pos(1)
	"@Thank you very much," linebreak
	"  " call(data_37.l_0xc7e6b3) "." next
	eob

LostUnderworld_Transaction_Thanks_2:	//l_0xc5369d
// when is this used?
	"@I'll give Angrez these colorful papers you gave me." next
	eob

LostUnderworld_Request_Another_Transaction:	//l_0xc536c1
	"@Will there be anything else today?" linebreak
	eob

LostUnderworld_Do_Another_Transaction:		//l_0xc536d2
	"@What are you going to do now?" linebreak
	eob

LostUnderworld_Chosen_Character_Inventory_Full:	//l_0xc536e1
	"@It looks like {name(0)} is overloaded with items." next
	"@You want to have one of your friends carry it?" linebreak
	eob

LostUnderworld_Bulk_Buy_Lots:
	get_char_at_pos(1)
	"@All of these items," call(data_37.l_0xc7e6b3) "?" next
	eob

LostUnderworld_Bulk_Buy_Not_Enough_Cash:
	sound(SND_ERRORBEEP)
	get_char_at_pos(1)
	"@" call(data_37.l_0xc7e6c5) ", it appears you do not have the money necessary for these transactions." next
	eob

LostUnderworld_Bulk_Buy_Full_Inventory:
	sound(SND_ERRORBEEP)
	"@I really don't think you can carry any more purchases." next
	"@You can come again after you sell something," next
	"@or you can simply discard an item to lighten your load." next
	"@Or, you might want to sell the things you don't need here!" next
	eob

LostUnderworld_Bulk_Buy_Change_Of_Mind:
	"@Well, the customer is always right." next
	eob

//------------------------------------------------------------------
