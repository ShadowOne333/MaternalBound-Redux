//------------------------------------------------------------------
// Summers Magic cake cart
//------------------------------------------------------------------
SummersMagicCake_Greeting:		//l_0xc5ca56
	title(1, Jill)
	"@I can no longer make Magic cakes..." next
	"@But it doesn't matter because now I'm selling Magic Tarts," next
	"@which taste even better than Magic cakes!" next
	eob

SummersMagicCake_Exit_Store_Buy:	//l_0xc5cab4
	title(1, Jill)
	"@You reminded me how much I love this job!" end

SummersMagicCake_Exit_Store_Dont_Buy:	//l_0xc5cad0
	title(1, Jill)
	"@You reminded me how much I love this job!" end

SummersMagicCake_Open_Shop_Window:	//l_0xc5caec
	title(1, Jill)
	"@I only have this....." next
	eob

SummersMagicCake_Selected_Item:		//l_0xc5cafe
	title(1, Jill)
	"@Are you going to buy" linebreak
	"  my {itemname(0)}?" next
	eob

SummersMagicCake_Who_Will_Take_Item:	//l_0xc5cb12
	title(1, Jill)
	"@Who is going to carry it?" promptw
	eob

SummersMagicCake_Equip_Now:			// This shop doesn't sell equippables
	eob

SummersMagicCake_Buy_Previous_Equipment:	// This shop doesn't sell equippables
 // arg: item name, res: item price
	eob

SummersMagicCake_Cant_Equip_Item:		// This shop doesn't sell equippables
// arg: player name
	eob

SummersMagicCake_Cancel_Cant_Equip:		//l_0xc5cb1e
// despite the name, it's often used as a generic change of mind
	title(1, Jill)
	"@That's too bad." end

SummersMagicCake_Not_Enough_Cash:		//l_0xc5cb29
	title(1, Jill)
	sound(SND_ERRORBEEP)
	"@You don't have enough money." end

SummersMagicCake_Whole_Party_Full_Inventory:	//l_0xc5cb33
	title(1, Jill)
	sound(SND_ERRORBEEP)
	"@You are carrying too many things." next
	"@Come again when you reduce the number of things you are carrying." end

SummersMagicCake_What_To_Sell:		// This shop doesn't purchase items
	eob

SummersMagicCake_Confirm_Selling:	// This shop doesn't purchase items
// arg: item ID, res: item sell price
	eob

SummersMagicCake_Cancel_Selling:	// This shop doesn't purchase items
	eob

SummersMagicCake_Nothing_To_Sell:	// This shop doesn't purchase items
	eob

SummersMagicCake_Unsellable_Item:	// This shop doesn't purchase items
	eob

SummersMagicCake_Transaction_Thanks:		//l_0xc5cb67
	title(1, Jill)
	"@Thank you very much." next
	eob

SummersMagicCake_Transaction_Thanks_2:		//l_0xc5cb71
// when is this used?
	title(1, Jill)
	"@Thank you again." next
	eob

SummersMagicCake_Request_Another_Transaction:	//l_0xc5cb7b
	title(1, Jill)
	"@Would you like to buy anything else?" linebreak
	eob

SummersMagicCake_Do_Another_Transaction:	// This shop doesn't run this line
	eob

SummersMagicCake_Chosen_Character_Inventory_Full:	//l_0xc5cb88
	title(1, Jill)
	"@{name(0)} seems to have too many things already." next
	"@I don't think " swap call(data_36.l_0xc7e5f3) " can carry any more." next
	"@Can someone else carry it?" linebreak
	eob

SummersMagicCake_Bulk_Buy_Lots:
	"@All those?" next
	eob

SummersMagicCake_Bulk_Buy_Not_Enough_Cash:
	title(1, Jill)
	sound(SND_ERRORBEEP)
	"@You don't have enough money." end

SummersMagicCake_Bulk_Buy_Full_Inventory:
	title(1, Jill)
	sound(SND_ERRORBEEP)
	"@You are carrying way too many things." next
	"@Come again when you reduce the number of things you are carrying." end

SummersMagicCake_Bulk_Buy_Change_Of_Mind:
	title(1, Jill)
	"@That's too bad." end

//------------------------------------------------------------------
// Summers Toto Shop
//------------------------------------------------------------------
SummersToto_Greeting:		//l_0xc524f7
	"@If ye be headin' to Scarabia, ye ought to shop here." next
	"@Things're expensive down there..." next
	"@So, what're ye lookin' fer?" linebreak
	eob

SummersToto_Exit_Store_Buy:	//l_0xc52546
	"@Thanks much." next
	"@If'n yer going to Scarabia, take care of yerself." end

SummersToto_Exit_Store_Dont_Buy:	//l_0xc5256c
	"@Please come again!" end

SummersToto_Open_Shop_Window:	//l_0xc52574
	"@What would ye like, then?" promptw
	eob

SummersToto_Selected_Item:	//l_0xc52583
	"@{itemname(0)}?" next
	eob

SummersToto_Who_Will_Take_Item:	//l_0xc5258b
	"@Which of ye is goin' to carry this?" promptw
	eob

SummersToto_Equip_Now:			//l_0xc525a4
	"@Would ye like to equip it here, then?" linebreak
	eob

SummersToto_Buy_Previous_Equipment:	//l_0xc525bb
 // arg: item name, res: item price
	"@Would ye like it if I bought yer" linebreak
	"  {itemname(0)}" linebreak
	"  for {swap}$" number(0) "?" linebreak
	eob

SummersToto_Cant_Equip_Item:		//l_0xc525e6
// arg: player name
	"@{name(0)} cannot equip this." next
	"@Do ye still want to buy it?" linebreak
	eob

SummersToto_Cancel_Cant_Equip:		//l_0xc52603
// despite the name, it's often used as a generic change of mind
	"@Yer not goin' to buy this thing?  All righty then." next
	eob

SummersToto_Not_Enough_Cash:		//l_0xc52622
	sound(SND_ERRORBEEP)
	"@Beggin' yer pardon, but it appears ye don't have enough money..." next
	eob

SummersToto_Whole_Party_Full_Inventory:	//l_0xc5264b
	sound(SND_ERRORBEEP)
	"@You've got entirely too many goodies." next
	"@Would ye like me to take some of those things off yer hands?" next
	"@I can buy the ones ye don't need, if ye want." linebreak
	eob

SummersToto_What_To_Sell:	//l_0xc526a2
	"@What would ye like to sell me, then?" promptw
	eob

SummersToto_Confirm_Selling:	//l_0xc526b8
// arg: item ID, res: item sell price
	"@{itemname(0)}?" linebreak
	"  I would pay {swap}$" number(0) "." next
	"@Are ye happy with my offer?" linebreak
	eob

SummersToto_Cancel_Selling:	//l_0xc526e5
	"@Oh, it's not quite what ye expected?  Well, all righty then." next
	eob

SummersToto_Nothing_To_Sell:	//l_0xc5270f
	"@Oh?  Well, it appears to me that ye don't have anything to sell." next
	eob

SummersToto_Unsellable_Item:	//l_0xc52732
	"@Beggin' yer pardon, but I can't buy that." next
	eob

SummersToto_Transaction_Thanks:		//l_0xc52750
	"@Here ye go.  Thank ye." next
	eob

SummersToto_Transaction_Thanks_2:	//l_0xc52764
// when is this used?
	"@Thank ye kindly." next
	eob

SummersToto_Request_Another_Transaction:	//l_0xc52776
	"@Will ye be needin' anything else?" linebreak
	eob

SummersToto_Do_Another_Transaction:	//l_0xc52788
	"@What do ye need now?" linebreak
	eob

SummersToto_Chosen_Character_Inventory_Full:	//l_0xc52796
	"@It appears {name(0)} has a full load." next
	"@Will someone else take this instead?" linebreak
	eob

SummersToto_Bulk_Buy_Lots:
	"@All these goodies?" next
	eob

SummersToto_Bulk_Buy_Not_Enough_Cash:
	sound(SND_ERRORBEEP)
	"@Beggin' yer pardon, but it appears ye don't have enough money..." next
	eob

SummersToto_Bulk_Buy_Full_Inventory:
	sound(SND_ERRORBEEP)
	"@You've got entirely way too many goodies." next
	"@Would ye like me to take some of those things off yer hands?" next
	"@I can buy the ones ye don't need, if ye want." linebreak
	eob

SummersToto_Bulk_Buy_Change_Of_Mind:
	"@Yer not goin' to buy this thing?  All righty then." next
	eob

