//------------------------------------------------------------------
import "../definitions/flags.ccs"
import "../essential/asm65816.ccs"
import "../expansion/ccexpand.ccs"
import "../essential/commands.ccs"
import "../essential/stdext.ccs"
import "../redux/window_titles.ccs"
//------------------------------------------------------------------
// Summers Restaurant
//------------------------------------------------------------------
SummersRestaurant_Greeting:		//l_0xc5bd92
	"@So, where's your mom and dad?" next
	"@You mean you kids came in here all by yourselves...?" next
	"@Well, I can make your order to go." next
	eob

SummersRestaurant_Exit_Store_Buy:	//l_0xc5bde0
	"@Thank you." next
	"@Be careful not to drop or spill it." end

SummersRestaurant_Exit_Store_Dont_Buy:	//l_0xc5be00
	"@We are looking forward to seeing you again." end

SummersRestaurant_Open_Shop_Window:	//l_0xc5be16
	"@What can I get for you?" promptw
	eob

SummersRestaurant_Selected_Item:	//l_0xc5be24
	"@You want" linebreak
	"  a {itemname(0)}?" next
	eob

SummersRestaurant_Who_Will_Take_Item:	//l_0xc5be34
	"@Whose order is this?" promptw
	eob

SummersRestaurant_Equip_Now:			// This shop doesn't sell equippables
	eob

SummersRestaurant_Buy_Previous_Equipment:	// This shop doesn't sell equippables
 // arg: item name, res: item price
	eob

SummersRestaurant_Cant_Equip_Item:		// This shop doesn't sell equippables
// arg: player name
	eob

SummersRestaurant_Cancel_Cant_Equip:		//l_0xc5be45
// despite the name, it's often used as a generic change of mind
	"@Please come again." next
	eob

SummersRestaurant_Not_Enough_Cash:		//l_0xc5be4e
	sound(SND_ERRORBEEP)
	"@Sorry, but you haven't got enough to cover the check." next
	eob

SummersRestaurant_Whole_Party_Full_Inventory:	//l_0xc5be6f
	sound(SND_ERRORBEEP)
	"@You are already carrying too much stuff." next
	"@You can sell your stuff, throw something away, or just abandon it." next
	"@Then, come again." end

SummersRestaurant_What_To_Sell:		// This shop doesn't purchase items
	eob

SummersRestaurant_Confirm_Selling:	// This shop doesn't purchase items
// arg: item ID, res: item sell price
	eob

SummersRestaurant_Cancel_Selling:	// This shop doesn't purchase items
	eob

SummersRestaurant_Nothing_To_Sell:	// This shop doesn't purchase items
	eob

SummersRestaurant_Unsellable_Item:	// This shop doesn't purchase items
	eob

SummersRestaurant_Transaction_Thanks:		//l_0xc5beb3
	"@Thank you." next
	eob

SummersRestaurant_Transaction_Thanks_2:		//l_0xc5beba
// when is this used?
	"@Thank you." next
	eob

SummersRestaurant_Request_Another_Transaction:	//l_0xc5bec1
	"@Do you want to order anything else?" linebreak
	eob

SummersRestaurant_Do_Another_Transaction:	// This shop doesn't run this line
	eob

SummersRestaurant_Chosen_Character_Inventory_Full:	//l_0xc5becd
	"@{name(0)} is already carrying too many things." next
	"@Can someone else carry it for " swap call(data_37.l_0xc7e6a4) "?" linebreak
	eob

SummersRestaurant_Bulk_Buy_Lots:
	"@Is that all?" next
	eob

SummersRestaurant_Bulk_Buy_Not_Enough_Cash:
	sound(SND_ERRORBEEP)
	"@Sorry, but you haven't got enough to cover the whole check." next
	eob

SummersRestaurant_Bulk_Buy_Full_Inventory:
	sound(SND_ERRORBEEP)
	"@You are already carrying way too much stuff." next
	"@You can sell your stuff, throw something away, or just abandon it." next
	"@Then, come again." end

SummersRestaurant_Bulk_Buy_Change_Of_Mind:
	"@Please come again." next
	eob

//------------------------------------------------------------------
// Summers Shop
//------------------------------------------------------------------
SummersShop_Greeting:		//l_0xc522ef
	"@Hi!  Welcome to my store." next
	"@What do you need?" linebreak
	eob

SummersShop_Exit_Store_Buy:	//l_0xc5230c
	"@Thank you!" end

SummersShop_Exit_Store_Dont_Buy:	//l_0xc52312
	"@This place isn't for looky loos.  If you're not buying, get out!" end

SummersShop_Open_Shop_Window:	//l_0xc52339
	"@So, you're going to buy something, eh?" promptw
	eob

SummersShop_Selected_Item:	//l_0xc5234d
	"@{itemname(0)}?" next
	eob

SummersShop_Who_Will_Take_Item:	//l_0xc52355
	"@Who's going to carry it?" promptw
	eob

SummersShop_Equip_Now:		//l_0xc52361
	"@Are you going to equip it here?" linebreak
	eob

SummersShop_Buy_Previous_Equipment:	//l_0xc52371
 // arg: item name, res: item price
	"@I'll buy your" linebreak
	"  {itemname(0)}" linebreak
	"  for {swap}$" number(0) "." next
	eob

SummersShop_Cant_Equip_Item:		//l_0xc5238f
// arg: player name
	"@Even though {name(0)} can't put this on, you still want to buy it?" next
	"@Well, it's your money..." linebreak
	eob

SummersShop_Cancel_Cant_Equip:		//l_0xc523be
// despite the name, it's often used as a generic change of mind
	"@Hurry back now." next
	eob

SummersShop_Not_Enough_Cash:		//l_0xc523cb
	sound(SND_ERRORBEEP)
	"@Hey!  What are you trying to pull?!  You haven't got enough money!!" next
	eob

SummersShop_Whole_Party_Full_Inventory:	//l_0xc523ef
	sound(SND_ERRORBEEP)
	"@Hey!  You've got enough junk already!" next
	"@Do you want to sell me some of the junk you don't need?" linebreak
	eob

SummersShop_What_To_Sell:	//l_0xc5241d
	"@What can you sell me?" promptw
	eob

SummersShop_Confirm_Selling:	//l_0xc5242b
	"@{itemname(0)}?" linebreak
	"  I'll give you {swap}$" number(0) "." next
	"@How would that be?" linebreak
	eob

SummersShop_Cancel_Selling:	//l_0xc5244f
	"@Hurrm.  Changed your mind, eh?" next
	eob

SummersShop_Nothing_To_Sell:	//l_0xc52469
	"@C'mon!" linebreak
	"  You don't have anything to sell, do you?!" next
	eob

SummersShop_Unsellable_Item:	//l_0xc52485
	"@Sorry, but I have no use for that." next
	eob

SummersShop_Transaction_Thanks:		//l_0xc5249a
	"@Hey, it was nice doing business with you." next
	eob

SummersShop_Transaction_Thanks_2:	//l_0xc524b2
// when is this used?
	"@Thanks." next
	eob

SummersShop_Request_Another_Transaction:	//l_0xc524b8
	"@Will there be anything else?" linebreak
	eob

SummersShop_Do_Another_Transaction:		//l_0xc524c5
	"@What else do you want?" linebreak
	eob

SummersShop_Chosen_Character_Inventory_Full:	//l_0xc524d2
	"@{name(0)} can't carry any more stuff." next
	"@Can one of you others carry it?" linebreak
	eob

SummersShop_Bulk_Buy_Lots:
	"@All these?" next
	eob

SummersShop_Bulk_Buy_Not_Enough_Cash:
	sound(SND_ERRORBEEP)
	"@Hey!  What are you trying to pull?!  You haven't got enough money!!" next
	eob

SummersShop_Bulk_Buy_Full_Inventory:
	sound(SND_ERRORBEEP)
	"@Hey!  You've got too much junk already!" next
	"@Do you want to sell me some of the junk you don't need?" linebreak
	eob

SummersShop_Bulk_Buy_Change_Of_Mind:
	"@Hurry back now." next
	eob

