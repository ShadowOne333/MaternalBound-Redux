	eob

SummersGelato_Cancel_Selling:	// This shop doesn't purchase items
	eob

SummersGelato_Nothing_To_Sell:	// This shop doesn't purchase items
	eob

SummersGelato_Unsellable_Item:	// This shop doesn't purchase items
	eob

SummersGelato_Transaction_Thanks:		//l_0xc5d00c
	"@Thank you very much." promptw
	eob

SummersGelato_Transaction_Thanks_2:		//l_0xc5d015
// when is this used?
	"@Thank you very much." promptw
	eob

SummersGelato_Request_Another_Transaction:	//l_0xc5d01e
	"@Would you like to buy one more?" linebreak
	eob

SummersGelato_Do_Another_Transaction:		// This shop doesn't run this line
	eob

SummersGelato_Chosen_Character_Inventory_Full:	//l_0xc5d02d
	"@{name(0)} is already carrying too many things." next
	"@Can someone else carry it?" linebreak
	eob

SummersGelato_Bulk_Buy_Lots:
	"@Is that all?" next
	eob

SummersGelato_Bulk_Buy_Not_Enough_Cash:
	sound(SND_ERRORBEEP)
