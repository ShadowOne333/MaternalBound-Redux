//------------------------------------------------------------------
// General Arms Dealer
// Used by multiple Arms Dealers shops throughout the game
// Shops 16, 21, 28, 47, 52
//------------------------------------------------------------------
GeneralArmsDealer_Greeting:		//l_0xc52d94
	"@Sssshhh!" linebreak
	"  Don't talk too loud!" next
	"@What do you want?" linebreak
	eob

GeneralArmsDealer_Exit_Store_Buy:	//l_0xc52dcc
	"@Will that be all?" linebreak
	"  Good luck, buddy!" end

l_0xc52db6:	// Unused line?
	"@...you again?!" linebreak
	"  What do you want now?" linebreak
	eob

GeneralArmsDealer_Exit_Store_Dont_Buy:	//l_0xc52de8
	"@So that's everything?" linebreak
	"  Keep on the watch for bad guys." end

GeneralArmsDealer_Open_Shop_Window:	//l_0xc52e0d
	"@I've got what you need." promptw
	eob

GeneralArmsDealer_Selected_Item:		//l_0xc52e1c
	"@{itemname(0)}?" next
	eob

GeneralArmsDealer_Who_Will_Take_Item:	//l_0xc52e24
	"@Who's gonna lug this around?" promptw
	eob

GeneralArmsDealer_Equip_Now:		//l_0xc52e3a
	"@OK.  I suppose you're going to want to equip it here?" linebreak
	eob

GeneralArmsDealer_Buy_Previous_Equipment:	//l_0xc52e59
 // arg: item name, res: item price
	"@The {itemname(0)}...?" linebreak
	"  I'd say about {swap}$" number(0) "." next
	"@Take it or leave it." linebreak
	eob

GeneralArmsDealer_Cant_Equip_Item:	//l_0xc52e85
// arg: player name
	"@{name(0)} won't be able to equip this." next
	"@Are you intent on purchasing it anyway?" linebreak
	eob

GeneralArmsDealer_Cancel_Cant_Equip:	//l_0xc52eb2
// despite the name, it's often used as a generic change of mind
	"@Well, that's showing good sense.  You shouldn't strain yourself too much." next
	eob

GeneralArmsDealer_Not_Enough_Cash:	//l_0xc52ed7
	sound(SND_ERRORBEEP)
	"@Hold it just a second!  You haven't got enough money!" next
	eob

GeneralArmsDealer_Whole_Party_Full_Inventory:	//l_0xc52ef5
	sound(SND_ERRORBEEP)
	"@You aren't going to be able to carry any more stuff." next
	"@You're dragging around all that junk..." next
	"@I guess I could help you out by buying some things that you don't need..." next
	eob

GeneralArmsDealer_What_To_Sell:		//l_0xc52f4a
	"@What are you going to pawn off on me?" promptw
	eob

GeneralArmsDealer_Confirm_Selling:	//l_0xc52f5f
// arg: item ID, res: item sell price
	"@{itemname(0)}?" linebreak
	"  I'll give you {swap}$" number(0) ", and not a penny more." next
	"@Take it or leave it." linebreak
	eob

GeneralArmsDealer_Cancel_Selling:	//l_0xc52f94
	"@...I don't think you'll find a better price anywhere else." next
	eob

GeneralArmsDealer_Nothing_To_Sell:	//l_0xc52fb6
	"@What are you trying to pull, anyway?" next
	"@You say you want to sell, but you have nothing to offer?!" next
	"@You've got some nerve, kid!" next
	eob

GeneralArmsDealer_Unsellable_Item:	//l_0xc52ffa
	"@Forget it!" linebreak
	"  I don't want to buy that junk!" next
	eob

GeneralArmsDealer_Transaction_Thanks:	//l_0xc53018
	"@Excellent." linebreak
	"  Glad we could work something out." next
	eob

GeneralArmsDealer_Transaction_Thanks_2:	//l_0xc53037
// when is this used?
	"@Thank you." pause(20)
	"  Things must be pretty tough, especially for a kid like you." next
	eob

GeneralArmsDealer_Request_Another_Transaction:	//l_0xc53063
	"@So, will there be anything else?" linebreak
	eob

GeneralArmsDealer_Do_Another_Transaction:	//l_0xc53072
	"@What is it now?" linebreak
	eob

GeneralArmsDealer_Chosen_Character_Inventory_Full:	//l_0xc5307d
	"@{name(0)} can't carry any more." next
	"@Is anyone else willing to carry it?" linebreak
	eob

GeneralArmsDealer_Bulk_Buy_Lots:
	"@All of these?" next eob

GeneralArmsDealer_Bulk_Buy_Not_Enough_Cash:
	sound(SND_ERRORBEEP)
	"@Hold it just a second!  You haven't got enough money!" next
	eob

GeneralArmsDealer_Bulk_Buy_Full_Inventory:
	sound(SND_ERRORBEEP)
	"@You aren't going to be able to carry all this stuff." next
	"@You're dragging around all that junk..." next
	"@I guess I could help you out by buying some things that you don't need..." next
	eob

GeneralArmsDealer_Bulk_Buy_Change_Of_Mind:
	"@Well, that's showing good sense.  You shouldn't strain yourself too much." next
	eob

