	eob

GeneralToolshop_Cancel_Selling:		//l_0xc52261
	"@Hummm.  Is that so?" next
	eob

GeneralToolshop_Nothing_To_Sell:	//l_0xc52272
	"@Oh, so you don't really have anything to sell?" next
	eob

GeneralToolshop_Unsellable_Item:	//l_0xc52288
	"@I'm sorry, but I can't buy that." next
	eob

GeneralToolshop_Transaction_Thanks:	//l_0xc52299
	"@Thank you very much." next
	eob

GeneralToolshop_Transaction_Thanks_2:	//l_0xc522a3
// when is this used?
	"@Thank you." next
	eob

GeneralToolshop_Request_Another_Transaction:	//l_0xc522aa
	"@Is there anything I can do for you?" linebreak
	eob

GeneralToolshop_Do_Another_Transaction:	//l_0xc522ba
	"@What can I do for you now?" linebreak
	eob

GeneralToolshop_Chosen_Character_Inventory_Full:	//l_0xc522ca
	"@{name(0)} can't carry any more." next
	"@Will another one of you take it?" linebreak
	eob

GeneralToolshop_Bulk_Buy_Lots:
	"@All of these?" next eob

GeneralToolshop_Bulk_Buy_Not_Enough_Cash:
	sound(SND_ERRORBEEP)
	"@I'm sorry, but you don't have enough money for all that." next
	eob

GeneralToolshop_Bulk_Buy_Full_Inventory:
	sound(SND_ERRORBEEP)
	"@Oh, how are you planning to carry these?  You've got too much stuff!" next
	"@Well, I guess I could buy the stuff you don't need." next
	"@Do you want to sell anything?" linebreak
	eob

GeneralToolshop_Bulk_Buy_Change_Of_Mind:
	"@Please come again." next
	eob

