//------------------------------------------------------------------
// Scarabia Normal shop
//------------------------------------------------------------------
ScarabiaShop_Greeting:		//l_0xc527c7
	"@Welcome, welcome!  Ach, the heat!  Is your body okay?" next
	"@Can I interest you in some of my merchandise?" linebreak
	eob

ScarabiaShop_Exit_Store_Buy:	//l_0xc52809
	"@Ohh, thank you very much.  May you never find rocks in your sandals." end

ScarabiaShop_Exit_Store_Dont_Buy:	//l_0xc52836
	"@Why don't you buy something?  I've got a family to feed!" end

ScarabiaShop_Open_Shop_Window:		//l_0xc52855
	"@What would you like?" promptw
	eob

ScarabiaShop_Selected_Item:		//l_0xc52860
	"@{itemname(0)}?" next
	eob

ScarabiaShop_Who_Will_Take_Item:	//l_0xc52868
	"@So, which of you will take this wonderful item?" promptw
	eob

ScarabiaShop_Equip_Now:			//l_0xc52885
	"@Will you equip it here?" linebreak
	eob

ScarabiaShop_Buy_Previous_Equipment:	//l_0xc52893
 // arg: item name, res: item price
	"@Would you be interested in selling your {itemname(0)}" next
	"@for {swap}$" number(0) "?" linebreak
	eob

ScarabiaShop_Cant_Equip_Item:		//l_0xc528bf
// arg: player name
	"@{name(0)} will have no use for this." next
	"@Do you still want to buy this marvelous thing?" linebreak
	eob

ScarabiaShop_Cancel_Cant_Equip:		//l_0xc528eb
// despite the name, it's often used as a generic change of mind
	"@Very well then." next
	eob

ScarabiaShop_Not_Enough_Cash:		//l_0xc528f9
	"@A thousand pardons, but you do not seem to have the money" next
	"@required to make this purchase." next
	eob

ScarabiaShop_Whole_Party_Full_Inventory:	//l_0xc52938
	"@Ahh, I can see that your caravan is overloaded." next
	"@Would you like to sell some of your extra items to me?" linebreak
	eob

ScarabiaShop_What_To_Sell:	//l_0xc52972
	"@Very well then, what would you like to sell?" promptw
	eob

ScarabiaShop_Confirm_Selling:	//l_0xc52989
// arg: item ID, res: item sell price
	"@{itemname(0)}?" linebreak
	"  Ahhh, I would pay you..." linebreak
	"  {swap}$" number(0) " for that." next
	"@A trifle, I realize, but do you accept?" linebreak
	eob

ScarabiaShop_Cancel_Selling:	//l_0xc529d2
	"@Very well then." next
	eob

ScarabiaShop_Nothing_To_Sell:	//l_0xc529e0
	"@From my humble vantage point, it appears you have nothing to sell." next
	eob

ScarabiaShop_Unsellable_Item:	//l_0xc52a09
	"@A thousand pardons.  We do not carry that item here." next
	eob

ScarabiaShop_Transaction_Thanks:	//l_0xc52a2a
	"@Ahh, you are most gracious and kind." next
	eob

ScarabiaShop_Transaction_Thanks_2:	//l_0xc52a45
// when is this used?
	"@Thank you for visiting my poor shop." next
	eob

ScarabiaShop_Request_Another_Transaction:	//l_0xc52a5c
	"@If there is anything else I can do for you, please, do not hesitate to ask." next
	eob

ScarabiaShop_Do_Another_Transaction:		//l_0xc52a82
	"@So, what more can I do for you?" linebreak
	eob

ScarabiaShop_Chosen_Character_Inventory_Full:	//l_0xc52a92
	"@{name(0)} simply cannot carry any more goods." next
	"@Perhaps another of your party could bear this load?" linebreak
	eob

ScarabiaShop_Bulk_Buy_Lots:
	"@All these items?" next
	eob

ScarabiaShop_Bulk_Buy_Not_Enough_Cash:
	"@A thousand pardons, but you do not seem to have the money" next
	"@required to make these purchases." next
	eob

ScarabiaShop_Bulk_Buy_Full_Inventory:
	"@Ahh, I can see that your caravan is overloaded." next
	"@Would you like to sell some of your extra items to me?" linebreak
	eob

ScarabiaShop_Bulk_Buy_Change_Of_Mind:
	"@Very well then." next
	eob

//------------------------------------------------------------------
// Scarabia Snake shop
//------------------------------------------------------------------
ScarabiaSnake_Greeting:		//l_0xc5c05f
	"@Hissss, Red Snake! C'mon!" next
	title(1, Snake)
	"@Kissss of Fire! Armpit hair fertilizer!" linebreak
	"  Yesssssss!" next
	eob

ScarabiaSnake_Exit_Store_Buy:	//l_0xc5c0ad
	title(1, Snake)
	"@Yesssss, you got ssssome good sssstuff!" end

ScarabiaSnake_Exit_Store_Dont_Buy:	//l_0xc5c0cb
	title(1, Snake)
	"@Oh, no..." next
	"@You dissssappoint me..." end

ScarabiaSnake_Open_Shop_Window:		//l_0xc5c0e3
	title(1, Snake)
	"@What issss it you want to buy?" promptw
	eob

ScarabiaSnake_Selected_Item:		//l_0xc5c0f3
	title(1, Snake)
	"@Hisssss, here isssss" linebreak
	"  your {itemname(0)}!" next
	eob

ScarabiaSnake_Who_Will_Take_Item:	//l_0xc5c10f
	title(1, Snake)
	"@Who issss going to carry thisssss?" promptw
	eob

ScarabiaSnake_Equip_Now:		// Snake seller doesn't have equippable items
	eob

ScarabiaSnake_Buy_Previous_Equipment:	// Snake seller doesn't have equippable items
 // arg: item name, res: item price
	eob

ScarabiaSnake_Cant_Equip_Item:		// Snake seller doesn't have equippable items
// arg: player name
	eob

ScarabiaSnake_Cancel_Cant_Equip:	//l_0xc5c125
// despite the name, it's often used as a generic change of mind
	title(1, Snake)
	"@Oh, no..." next
	"@You dissssappoint me..." next
	eob

ScarabiaSnake_Not_Enough_Cash:		//l_0xc5c13e
	title(1, Snake)
	"@Oh, no..." next
	"@You dissssappoint me...  You don't have enough money..." next
	eob

ScarabiaSnake_Whole_Party_Full_Inventory:	//l_0xc5c161
	title(1, Snake)
	"@You are carrying too much ssssstuff" next
	"@Ssssell it, or tossss it, and come again!" end

ScarabiaSnake_What_To_Sell:	// Snake seller doesn't purchase items
	eob

ScarabiaSnake_Confirm_Selling:	// Snake seller doesn't purchase items
// arg: item ID, res: item sell price
	eob

ScarabiaSnake_Cancel_Selling:	// Snake seller doesn't purchase items
	eob

ScarabiaSnake_Nothing_To_Sell:	// Snake seller doesn't purchase items
	eob

ScarabiaSnake_Unsellable_Item:	// Snake seller doesn't purchase items
	eob

ScarabiaSnake_Transaction_Thanks:	//l_0xc5c192
	title(1, Snake)
	"@Thankssssss!" next
	eob

ScarabiaSnake_Transaction_Thanks_2:	//l_0xc5c19d
// when is this used?
	title(1, Snake)
	"@Thanksssss!" next
	eob

ScarabiaSnake_Request_Another_Transaction:	//l_0xc5c1a7
	title(1, Snake)
	"@Can I do anything elsssse for you?" linebreak
	eob

ScarabiaSnake_Do_Another_Transaction:		// Snake seller doesn't run this line
	eob

ScarabiaSnake_Chosen_Character_Inventory_Full:	//l_0xc5c1be
	title(1, Snake)
	"@You have too many thingssss to carry." next
	"@Can anyone elsssse carry it?" linebreak
	eob

ScarabiaSnake_Bulk_Buy_Lots:
	"@All thesssse?" next
	eob

ScarabiaSnake_Bulk_Buy_Not_Enough_Cash:
	title(1, Snake)
	"@Oh, no..." next
	"@You dissssappoint me...  You don't have enough money..." next
	eob

ScarabiaSnake_Bulk_Buy_Full_Inventory:
	title(1, Snake)
	"@You are carrying too much ssssstuff" next
	"@Ssssell it, or tossss it, and come again!" end

ScarabiaSnake_Bulk_Buy_Change_Of_Mind:
	title(1, Snake)
	"@Oh, no..." next
	"@You dissssappoint me..." next
	eob

