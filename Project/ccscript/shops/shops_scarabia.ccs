	"@What gives?  You don't have anything to sell." promptw
	eob

ScarabiaTool_Unsellable_Item:	//l_0xc52d03
	"@Look, I'm really sorry, but we can't buy that." next
	eob

ScarabiaTool_Transaction_Thanks:	//l_0xc52d1e
	"@Thanks a million!" next
	eob

ScarabiaTool_Transaction_Thanks_2:	//l_0xc52d2c
// when is this used?
