ScarabiaTool_Do_Another_Transaction:		//l_0xc52d54
	"@What'll it be?" linebreak
	eob

ScarabiaTool_Chosen_Character_Inventory_Full:	//l_0xc52d5f
	"@Sakes alive! {name(0)} can't carry another thing." next
