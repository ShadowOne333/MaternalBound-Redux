//------------------------------------------------------------------
// Scarabia South Pyramid seller
//------------------------------------------------------------------
ScarabiaSouthPyramid_Greeting:		//l_0xc5b3ba
	"@Since I'm dealing in some pretty rough stuff," next
	"@I can't run my business in town." next
	eob

ScarabiaSouthPyramid_Exit_Store_Buy:	//l_0xc5b3eb
	"@See you later." end

ScarabiaSouthPyramid_Exit_Store_Dont_Buy:	//l_0xc5b3f6
	"@See you... later." end

ScarabiaSouthPyramid_Open_Shop_Window:		//l_0xc5b405
	"@I've got a wide selection.  What are you looking for?" promptw
	eob

ScarabiaSouthPyramid_Selected_Item: {		//l_0xc5b426
	"@{itemname(0)}?" next
	// Check if the item we're getting is the Bazooka, so it gives a special text
	if flag FLG_TOOL_ITEMS {
		swap
		result_is(BAZOOKA)
		goto_if_true(_is_bazooka)
		load_registers
	}
	eob

_is_bazooka:
	// Added check for money
	hasmoney(950)
	goto_if_false(ScarabiaSouthPyramid_Not_Enough_Cash)
	takemoney(950)	// 0x0000
	show_wallet
	sound(SND_GUITAR)

	unset(FLG_SHOP_TOOK)	// 224
	unset(FLG_SHOP_SOLD)	// 225

	set(FLG_ITEM_BAZOOKA)
	"@Hey, thanks!" next
	"@That's a one-of-a-kind weapon, so be careful with it!" next
	give_menu_tools_item(BAZOOKA)
	newline
	eob
}

ScarabiaSouthPyramid_Who_Will_Take_Item:	//l_0xc5b42e
	"@Who's going to get this?" promptw
	eob

ScarabiaSouthPyramid_Equip_Now:			//l_0xc5b43c
	"@Do you want to equip it here?" linebreak
	eob

ScarabiaSouthPyramid_Buy_Previous_Equipment:	//l_0xc5b447
 // arg: item name, res: item price
	"@Would you like me to buy" linebreak
	"  your {itemname(0)}" next
	"@for {swap}$" number(0) "?" linebreak
	eob

ScarabiaSouthPyramid_Cant_Equip_Item:		//l_0xc5b468
// arg: player name
	"@{name(0)} can't equip this." next
	"@Are you still interested in buying it?" linebreak
	eob

ScarabiaSouthPyramid_Cancel_Cant_Equip:		//l_0xc5b48c
// despite the name, it's often used as a generic change of mind
	"@Ain't that the pits..." next
	"@I'm actually gonna have to wait for another customer in this crazy heat?" next
	"@That's harsh..." next
	eob

ScarabiaSouthPyramid_Not_Enough_Cash:		//l_0xc5b4d7
	"@If you don't have enough money," next
	"@it's a waste of my time to even talk about dealing with you." next
	eob

ScarabiaSouthPyramid_Whole_Party_Full_Inventory:	//l_0xc5b507
	"@You guys are completely overloaded." next
	"@However, I can buy the stuff you don't need." next
	"@What do you want to do?" linebreak
	eob

ScarabiaSouthPyramid_What_To_Sell:	//l_0xc5b541
	"@What are you going to sell me?" wait
	eob

ScarabiaSouthPyramid_Confirm_Selling:	//l_0xc5b551
// arg: item ID, res: item sell price
	"@{itemname(0)}?" linebreak
	"  Let's see..." next
	"@How about {swap}$" number(0) "?" linebreak
	eob

ScarabiaSouthPyramid_Cancel_Selling:	//l_0xc5b572
	"@OK.  I thought my offer was more than fair." next
	eob

ScarabiaSouthPyramid_Nothing_To_Sell:	//l_0xc5b591
	"@Are you trying to con me?  You've got nothing to sell!!" next
	eob

ScarabiaSouthPyramid_Unsellable_Item:	//l_0xc5b5b1
	"@Sorry, that is an item I just don't deal in." next
	eob

ScarabiaSouthPyramid_Transaction_Thanks:	//l_0xc5b5ce
	"@Hey, thanks!" next
	eob

ScarabiaSouthPyramid_Transaction_Thanks_2:	//l_0xc5b5d8
// when is this used?
	"@Hey, thanks!" next
	eob

ScarabiaSouthPyramid_Request_Another_Transaction:	//l_0xc5b5e2
	"@Is there anything else you need?" linebreak
	eob

ScarabiaSouthPyramid_Do_Another_Transaction:		//l_0xc5b5f0
