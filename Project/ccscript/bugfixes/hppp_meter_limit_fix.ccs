//------------------------------------
// HP/PP box max HP limit fix by ShadowOne333
//------------------------------------
import "../essential/asm65816.ccs"
//------------------------------------
// If the HP or PP values exceed 999, the HP/PP box meter will start displaying glitched graphics to represent >999 numbers.
// A similar issue occurs if the player views the Status screen from the main menu, where if the HP/PP values surpass 999, they will display the actual amount >999, though unlike with the HP/PP meter, this display isn't glitched, except for the current HP/PP value, which does cut-off the last digit out of anything above 999.
// This code fixes that issue by limiting the maximum HP and PP numbers when levelling up to have a maximum limit of 999.
// This automatically limits both the HP/PP meters and the Status screen numbers since the Level Up checks limit the max value to 999 instead of overflowing past it.
//------------------------------------
//	HP Limit fixes
//------------------------------------
// Apply the max HP limit on character Level Up for Max HP
ROM[0xC1D66A] = JML	(Max_HP_Limit_Fix)

Max_HP_Limit_Fix: {
	ADC_d	(0x02)		// VIRTUAL02

	// Added check to make the maximum limit 999 instead of overflowing
	CMP_i	(999)		// Check if we're at 999 HP
	BCC	(3)		// If less than 999 HP, continue to HP/PP tile buffer
	LDA_i	(999) 		// Otherwise, force the max HP number to be 999 before printing the value

	STA_x	(0x0000)	// __BSS_START__

	JML	(0xC1D66F)	// Return to the original hijacked code 
}

// Apply the max HP limit on character Level Up for current HP
ROM[0xC1D67A] = JML	(Current_HP_Limit_Fix)

Current_HP_Limit_Fix: {
	ADC_d	(0x02)		// VIRTUAL02

	// Added check to make the maximum limit 999 instead of overflowing
	CMP_i	(999)		// Check if we're at 999 HP
	BCC	(3)		// If less than 999 HP, continue to HP/PP tile buffer
	LDA_i	(999) 		// Otherwise, force the max HP number to be 999 before printing the value

	STA_x	(0x0000)	// __BSS_START__

	JML	(0xC1D67F)	// Return to the original hijacked code 
}
//------------------------------------
//	PP Limit fixes
//------------------------------------
// Apply the max PP limit on character Level Up for Max PP
ROM[0xC1D73C] = JML	(Max_PP_Limit_Fix)

Max_PP_Limit_Fix: {
	ADC_d	(0x02)		// VIRTUAL02

	// Added check to make the maximum limit 999 instead of overflowing
	CMP_i	(999)		// Check if we're at 999 HP
	BCC	(3)		// If less than 999 HP, continue to HP/PP tile buffer
	LDA_i	(999) 		// Otherwise, force the max HP number to be 999 before printing the value

	STA_x	(0x0000)	// __BSS_START__

	JML	(0xC1D741)	// Return to the original hijacked code 
}

// Apply the max PP limit on character Level Up for current PP
ROM[0xC1D752] = JML	(Current_PP_Limit_Fix)

Current_PP_Limit_Fix: {
	ADC_d	(0x02)		// VIRTUAL02

	// Added check to make the maximum limit 999 instead of overflowing
	CMP_i	(999)		// Check if we're at 999 HP
	BCC	(3)		// If less than 999 HP, continue to HP/PP tile buffer
	LDA_i	(999) 		// Otherwise, force the max HP number to be 999 before printing the value

	STA_x	(0x0000)	// __BSS_START__

	JML	(0xC1D757)	// Return to the original hijacked code 
}
//------------------------------------
