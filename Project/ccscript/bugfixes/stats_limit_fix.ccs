//------------------------------------
//	Vitality Max Limit fixes
//------------------------------------
// Apply the max Vitality limit on character Level Up
ROM[0xC21D72] = JML	(Max_Vitality_Limit_Fix)

Max_Vitality_Limit_Fix: {
	LDA_x	(0x99EF)	// PARTY_CHARACTERS+char_struct::base_vitality,X
	CLC
	ADC_x	(0x9A27)	// PARTY_CHARACTERS+char_struct::boosted_vitality,X

	// Added check to make the maximum limit 255 instead of overflowing
	BVS	(2)		// Branch if Overflow Set
	LDA_8	(0xFF)		// Otherwise, force the max Vitality number to be 255 before printing the value

	STA_x	(0x99E8)	// PARTY_CHARACTERS+char_struct::vitality,X
	JML	(0xC21D7C)	// Return to the original hijacked code 
}
//------------------------------------
//	IQ Max Limit fixes
//------------------------------------
// Apply the max IQ limit on character Level Up
ROM[0xC21D8A] = JML	(Max_IQ_Limit_Fix)

Max_IQ_Limit_Fix: {
	LDA_x	(0x99F0)	// PARTY_CHARACTERS+char_struct::base_iq,X
	CLC
	ADC_x	(0x9A28)	// PARTY_CHARACTERS+char_struct::boosted_iq,X

	// Added check to make the maximum limit 255 instead of overflowing
	BVS	(2)		// Branch if Overflow Set
	LDA_8	(0xFF)		// Otherwise, force the max Vitality number to be 255 before printing the value

	STA_x	(0x99E9)	// PARTY_CHARACTERS+char_struct::iq,X

	JML	(0xC21D94)	// Return to the original hijacked code 
}
